@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1>Something went wrong</h1>
<p class="lead">Comfy Capy Calories could not finish that request.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Please try again. If the problem continues, keep the request ID above to help us investigate.</p>
<a asp-area="" asp-page="/Index" class="btn btn-primary">Return home</a>
