@page
@model IndexModel
@using CalorieTracker.Services
@{
    ViewData["Title"] = "Calorie & Macro Tracker";
    ViewData["MetaDescription"] =
        "Track calories, macros and daily food with a customisable Comfy Capy.";
    ViewData["CanonicalUrl"] = "https://calories.comfycapy.com/";
    ViewData["Robots"] = "index,follow";
}

@section Scripts {
    <script src="~/js/calorie-year-map.js" asp-append-version="true"></script>
}

@if (User.Identity?.IsAuthenticated == true)
{
    var caloriePercentage =
        Model.CalorieTarget.HasValue &&
        Model.CalorieTarget.Value > 0
            ? Math.Min(
                100,
                (double)(Model.CaloriesConsumed /
                    Model.CalorieTarget.Value * 100))
            : 0;
    var macroGoals = Model.MacroGoalProgress;
    var caloriePercentageText = caloriePercentage.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);

    <div class="dashboard-page">
        @await Html.PartialAsync(
            "_ScenicPageHeader",
            new CalorieTracker.Models.ScenicPageHeaderModel(
                Title: Model.DashboardGreeting,
                Subtitle: "Here’s today at a glance. Log what you need, then get on with your day.",
                Eyebrow: Model.CurrentDate.ToString("dddd, d MMMM"),
                ArtworkPath: "/images/brand/dashboard-hero-capy.png",
                CssClass: "dashboard-hero"))

        @if (!Model.HasProfileEstimates)
        {
            <div class="dashboard-setup-card">
                <div>
                    <h2>
                        @(Model.UserProfile == null
                            ? "Finish setting up your profile"
                            : "Update your profile")
                    </h2>

                    <p>
                        Add valid body and activity details so we can calculate
                        your personal calorie estimates.
                    </p>
                </div>

                <a asp-page="/Profile/Index"
                   class="btn btn-primary">
                    @(Model.UserProfile == null ? "Set up profile" : "Update profile")
                </a>
            </div>
        }

        <div class="dashboard-primary-grid">
            <section class="dashboard-main-card"
                     aria-labelledby="dashboard-calories-heading">
                <div class="dashboard-card-heading">
                    <div>
                        <p class="dashboard-eyebrow">Today</p>
                        <h2 id="dashboard-calories-heading">Daily calories</h2>
                    </div>
                    <a asp-page="/Diary/Index"
                       asp-route-date="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="dashboard-text-link">
                        View Diary →
                    </a>
                </div>

                <div class="dashboard-calorie-layout">
                    @if (Model.CalorieTarget.HasValue)
                    {
                        var calorieProgressDescription = Model.CaloriesRemaining >= 0
                            ? $"{Model.CaloriesConsumed:0} kcal consumed of {Model.CalorieTarget.Value:0} kcal. {Model.CaloriesRemaining:0} kcal remaining."
                            : $"{Model.CaloriesConsumed:0} kcal consumed of {Model.CalorieTarget.Value:0} kcal. {Math.Abs(Model.CaloriesRemaining!.Value):0} kcal over target.";

                        <div class="dashboard-calorie-ring"
                             style="--dashboard-calorie-progress: @caloriePercentageText%;"
                             role="progressbar"
                             aria-label="Daily calorie progress"
                             aria-valuenow="@caloriePercentageText"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuetext="@calorieProgressDescription">
                            <div class="dashboard-calorie-ring-centre">
                                <span class="dashboard-calorie-current">
                                    @Model.CaloriesConsumed.ToString("0")
                                </span>
                                <span>kcal consumed</span>
                            </div>
                        </div>

                        <dl class="dashboard-calorie-metrics">
                            <div>
                                <dt>Daily target</dt>
                                <dd>@Model.CalorieTarget.Value.ToString("0") kcal</dd>
                            </div>
                            <div>
                                @if (Model.CaloriesRemaining >= 0)
                                {
                                    <dt>Remaining</dt>
                                    <dd>@Model.CaloriesRemaining.Value.ToString("0") kcal</dd>
                                }
                                else
                                {
                                    <dt>Over target</dt>
                                    <dd>@Math.Abs(Model.CaloriesRemaining!.Value).ToString("0") kcal</dd>
                                }
                            </div>
                            <div>
                                <dt>Progress</dt>
                                <dd>@caloriePercentage.ToString("0")%</dd>
                            </div>
                        </dl>
                    }
                    else
                    {
                        <div class="dashboard-calorie-ring is-unset"
                             role="img"
                             aria-label="@Model.CaloriesConsumed.ToString("0") calories consumed today. No daily target is available.">
                            <div class="dashboard-calorie-ring-centre">
                                <span class="dashboard-calorie-current">
                                    @Model.CaloriesConsumed.ToString("0")
                                </span>
                                <span>kcal consumed</span>
                            </div>
                        </div>

                        <div class="dashboard-calorie-empty">
                            <strong>Your daily target will appear here.</strong>
                            <p>
                                Set up your profile to see calories remaining
                                and personalised macro targets.
                            </p>
                        </div>
                    }
                </div>
            </section>

            <section class="dashboard-macro-section"
                     aria-labelledby="dashboard-macro-heading">
                <div class="dashboard-card-heading">
                    <div>
                        <p class="dashboard-eyebrow">Today</p>
                        <h2 id="dashboard-macro-heading">Macros</h2>
                    </div>
                    <span class="dashboard-heading-note">grams</span>
                </div>

                <div id="dashboardMacroCards" class="dashboard-macro-grid">
                    <div class="dashboard-macro-card">
                        <div class="dashboard-macro-icon" aria-hidden="true">P</div>
                        <div class="dashboard-macro-content">
                            <div class="dashboard-macro-copy">
                                <span class="dashboard-macro-label">Protein</span>
                                @if (macroGoals == null)
                                {
                                    <strong class="dashboard-macro-value">
                                        @Model.ProteinConsumed.ToString("0.0") g
                                    </strong>
                                }
                                else
                                {
                                    <strong class="dashboard-macro-value">
                                        @macroGoals.Protein.ConsumedGrams.ToString("0.0")
                                        <span>/ @macroGoals.Protein.TargetGrams.ToString("0.#") g</span>
                                    </strong>
                                }
                            </div>
                            @if (macroGoals != null)
                            {
                                <div class="macro-goal-progress macro-goal-item--protein"
                                     role="progressbar"
                                     aria-label="Protein macro goal progress"
                                     aria-valuenow="@macroGoals.Protein.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-valuetext="@macroGoals.Protein.ConsumedGrams.ToString("0.0") grams consumed of @macroGoals.Protein.TargetGrams.ToString("0.#") grams">
                                    <span style="width: @macroGoals.Protein.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="dashboard-macro-card">
                        <div class="dashboard-macro-icon" aria-hidden="true">C</div>
                        <div class="dashboard-macro-content">
                            <div class="dashboard-macro-copy">
                                <span class="dashboard-macro-label">Carbohydrates</span>
                                @if (macroGoals == null)
                                {
                                    <strong class="dashboard-macro-value">
                                        @Model.CarbohydratesConsumed.ToString("0.0") g
                                    </strong>
                                }
                                else
                                {
                                    <strong class="dashboard-macro-value">
                                        @macroGoals.Carbohydrates.ConsumedGrams.ToString("0.0")
                                        <span>/ @macroGoals.Carbohydrates.TargetGrams.ToString("0.#") g</span>
                                    </strong>
                                }
                            </div>
                            @if (macroGoals != null)
                            {
                                <div class="macro-goal-progress macro-goal-item--carbohydrates"
                                     role="progressbar"
                                     aria-label="Carbohydrates macro goal progress"
                                     aria-valuenow="@macroGoals.Carbohydrates.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-valuetext="@macroGoals.Carbohydrates.ConsumedGrams.ToString("0.0") grams consumed of @macroGoals.Carbohydrates.TargetGrams.ToString("0.#") grams">
                                    <span style="width: @macroGoals.Carbohydrates.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="dashboard-macro-card">
                        <div class="dashboard-macro-icon" aria-hidden="true">F</div>
                        <div class="dashboard-macro-content">
                            <div class="dashboard-macro-copy">
                                <span class="dashboard-macro-label">Fat</span>
                                @if (macroGoals == null)
                                {
                                    <strong class="dashboard-macro-value">
                                        @Model.FatConsumed.ToString("0.0") g
                                    </strong>
                                }
                                else
                                {
                                    <strong class="dashboard-macro-value">
                                        @macroGoals.Fat.ConsumedGrams.ToString("0.0")
                                        <span>/ @macroGoals.Fat.TargetGrams.ToString("0.#") g</span>
                                    </strong>
                                }
                            </div>
                            @if (macroGoals != null)
                            {
                                <div class="macro-goal-progress macro-goal-item--fat"
                                     role="progressbar"
                                     aria-label="Fat macro goal progress"
                                     aria-valuenow="@macroGoals.Fat.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-valuetext="@macroGoals.Fat.ConsumedGrams.ToString("0.0") grams consumed of @macroGoals.Fat.TargetGrams.ToString("0.#") grams">
                                    <span style="width: @macroGoals.Fat.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @if (Model.CalorieBalanceYear is { } balanceYear)
        {
            var firstDayOffset = ((int)balanceYear.Days[0].Date.DayOfWeek + 6) % 7;
            var weekCount =
                (firstDayOffset + balanceYear.Days.Count + 6) / 7;
            var monthBoundaryWeeks = Enumerable.Range(2, 11)
                .Select(month =>
                {
                    var monthDate = new DateOnly(balanceYear.Year, month, 1);
                    return (firstDayOffset + monthDate.DayOfYear - 1) / 7 + 1;
                })
                .Where(week => week > 1)
                .Distinct()
                .ToHashSet();
            var gridColumns = "2rem";

            for (var week = 1; week <= weekCount; week++)
            {
                if (monthBoundaryWeeks.Contains(week))
                {
                    gridColumns += " 0.3rem";
                }

                gridColumns += " 0.78rem";
            }

            int VisualWeekColumn(int week) =>
                week + 1 + monthBoundaryWeeks.Count(boundaryWeek => boundaryWeek <= week);

            var weekdayNames = new[]
            {
                "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"
            };

            string StateClass(CalorieBalanceClassification classification) =>
                classification switch
                {
                    CalorieBalanceClassification.HeavyCut => "is-heavy-cut",
                    CalorieBalanceClassification.LightCut => "is-light-cut",
                    CalorieBalanceClassification.Maintenance => "is-maintenance",
                    CalorieBalanceClassification.LightGain => "is-light-gain",
                    CalorieBalanceClassification.HeavyGain => "is-heavy-gain",
                    _ => "is-unclassified"
                };

            <section class="dashboard-year-card calorie-year-map"
                     aria-labelledby="calorie-year-heading"
                     data-calorie-balance-year="@balanceYear.Year">

                <div class="dashboard-year-heading">
                    <div>
                        <h2 id="calorie-year-heading">Your year</h2>
                        <p>
                            See how your logged calorie intake has compared with
                            your maintenance throughout @balanceYear.Year.
                        </p>
                    </div>

                    <nav class="calorie-year-navigation"
                         aria-label="Calorie balance year">
                        @if (Model.CanNavigatePrevious)
                        {
                            <a asp-page="/Index"
                               asp-route-year="@(balanceYear.Year - 1)"
                               class="btn btn-sm btn-outline-secondary"
                               aria-label="View @(balanceYear.Year - 1)">
                                &lsaquo;
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-outline-secondary disabled"
                                  aria-hidden="true">
                                &lsaquo;
                            </span>
                        }

                        <strong aria-current="page">@Model.SelectedYear</strong>

                        @if (Model.CanNavigateNext)
                        {
                            <a asp-page="/Index"
                               asp-route-year="@(balanceYear.Year + 1)"
                               class="btn btn-sm btn-outline-secondary"
                               aria-label="View @(balanceYear.Year + 1)">
                                &rsaquo;
                            </a>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-outline-secondary disabled"
                                  aria-hidden="true">
                                &rsaquo;
                            </span>
                        }
                    </nav>
                </div>

                <div class="calorie-year-scroll"
                     role="region"
                     aria-label="Calorie balance calendar for @balanceYear.Year"
                     tabindex="0">
                    <div class="calorie-year-grid"
                         style="--calorie-year-weeks: @weekCount; --calorie-year-grid-columns: @gridColumns;">

                        @for (var month = 1; month <= 12; month++)
                        {
                            var monthDate = new DateOnly(
                                balanceYear.Year,
                                month,
                                1);
                            var monthWeek =
                                (firstDayOffset + monthDate.DayOfYear - 1) / 7 + 2;
                            var monthColumn = VisualWeekColumn(monthWeek - 1);

                            <span class="calorie-year-month"
                                  data-month="@month"
                                  style="--calorie-year-month-week: @monthWeek; --calorie-year-month-column: @monthColumn;"
                                  aria-hidden="true">
                                @monthDate.ToString(
                                    "MMM",
                                    System.Globalization.CultureInfo.InvariantCulture)
                            </span>
                        }

                        @for (var weekday = 0;
                              weekday < weekdayNames.Length;
                              weekday++)
                        {
                            <span class="calorie-year-weekday"
                                  style="--calorie-year-weekday: @(weekday + 2);"
                                  aria-hidden="true">
                                @weekdayNames[weekday]
                            </span>
                        }

                        @foreach (var day in balanceYear.Days)
                        {
                            var week =
                                (firstDayOffset + day.Date.DayOfYear - 1) / 7 + 2;
                            var calendarColumn = VisualWeekColumn(week - 1);
                            var weekday = ((int)day.Date.DayOfWeek + 6) % 7 + 2;
                            var geometryStyle =
                                $"--calorie-year-week: {week}; --calorie-year-weekday: {weekday}; --calorie-year-column: {calendarColumn};";

                            if (!day.HasDiaryData)
                            {
                                <span class="calorie-year-day is-no-data"
                                      style="@geometryStyle"
                                      data-date="@day.Date.ToString("yyyy-MM-dd")"
                                      data-state="no-data"
                                      aria-hidden="true">
                                </span>
                                continue;
                            }

                            var dateText = day.Date.ToString("d MMMM yyyy");
                            var loggedText = day.CaloriesConsumed!.Value
                                .ToString("0");

                            if (!day.Classification.HasValue)
                            {
                                var unavailableDescription =
                                    $"{dateText}. Logged: {loggedText} kcal. " +
                                    "No maintenance data is available.";

                                <a asp-page="/Diary/Index"
                                   asp-route-date="@day.Date.ToString("yyyy-MM-dd")"
                                   class="calorie-year-day is-unclassified"
                                   style="@geometryStyle"
                                   data-date="@day.Date.ToString("yyyy-MM-dd")"
                                   data-state="unclassified"
                                   aria-label="@unavailableDescription">
                                    <span class="calorie-year-tooltip"
                                          aria-hidden="true">
                                        <strong>@dateText</strong>
                                        <span>Logged: @loggedText kcal</span>
                                        <span>No maintenance data</span>
                                    </span>
                                </a>
                                continue;
                            }

                            var definition = CalorieBalanceClassifier
                                .GetDefinition(day.Classification.Value);
                            var maintenanceText = day.MaintenanceCalories!.Value
                                .ToString("0");
                            var differenceText = day.Difference!.Value >= 0
                                ? $"+{day.Difference.Value:0}"
                                : day.Difference.Value.ToString("0");
                            var percentageText = day.BalancePercentage!.Value >= 0
                                ? $"+{day.BalancePercentage.Value:0.#}"
                                : day.BalancePercentage.Value.ToString("0.#");
                            var description =
                                $"{dateText}. Logged: {loggedText} kcal. " +
                                $"Maintenance: {maintenanceText} kcal. " +
                                $"Balance: {differenceText} kcal ({percentageText}%). " +
                                $"{definition.DisplayName}.";

                            <a asp-page="/Diary/Index"
                               asp-route-date="@day.Date.ToString("yyyy-MM-dd")"
                               class="calorie-year-day @StateClass(day.Classification.Value)"
                               style="@geometryStyle"
                               data-date="@day.Date.ToString("yyyy-MM-dd")"
                               data-state="@day.Classification.Value.ToString().ToLowerInvariant()"
                               aria-label="@description">
                                <span class="calorie-year-tooltip"
                                      aria-hidden="true">
                                    <strong>@dateText</strong>
                                    <span>Logged: @loggedText kcal</span>
                                    <span>Maintenance: @maintenanceText kcal</span>
                                    <span>
                                        Balance: @differenceText kcal (@percentageText%)
                                    </span>
                                    <span>@definition.DisplayName</span>
                                </span>
                            </a>
                        }
                    </div>
                </div>

                <div class="calorie-year-tooltip-layer"
                     aria-hidden="true"></div>

                <ul class="calorie-year-legend"
                    aria-label="Calorie balance legend">
                    @foreach (var definition in
                              CalorieBalanceClassifier.LegendDefinitions)
                    {
                        var legendDescription = definition.Classification switch
                        {
                            CalorieBalanceClassification.HeavyCut =>
                                $"20% or more below maintenance. Exact boundary: {definition.PercentageRange}.",
                            CalorieBalanceClassification.LightCut =>
                                $"More than 5% and less than 20% below maintenance. Exact boundary: {definition.PercentageRange}.",
                            CalorieBalanceClassification.Maintenance =>
                                $"Within 5% of maintenance, including the boundaries. Exact boundary: {definition.PercentageRange}.",
                            CalorieBalanceClassification.LightGain =>
                                $"More than 5% and less than 20% above maintenance. Exact boundary: {definition.PercentageRange}.",
                            CalorieBalanceClassification.HeavyGain =>
                                $"20% or more above maintenance. Exact boundary: {definition.PercentageRange}.",
                            _ => definition.PercentageRange
                        };
                        var legendDescriptionId =
                            $"calorie-year-legend-{definition.Classification.ToString().ToLowerInvariant()}-description";

                        <li aria-describedby="@legendDescriptionId">
                            <span class="calorie-year-legend-swatch @StateClass(definition.Classification)"
                                  aria-hidden="true"></span>
                            <span>
                                <strong>@definition.DisplayName</strong>
                                <span id="@legendDescriptionId"
                                      class="visually-hidden">
                                    @legendDescription
                                </span>
                            </span>
                        </li>
                    }
                    <li>
                        <span class="calorie-year-legend-swatch is-no-data"
                              aria-hidden="true"></span>
                        <span><strong>No Data</strong></span>
                    </li>
                    <li class="calorie-year-legend-exception">
                        <span class="calorie-year-legend-swatch is-unclassified"
                              aria-hidden="true"></span>
                        <span><strong>No maintenance data</strong></span>
                    </li>
                </ul>

            </section>
        }

        @if (Model.HasProfileEstimates && Model.UserProfile != null)
        {
            <section class="card dashboard-estimates-card"
                     aria-labelledby="dashboard-estimates-heading">
                <div class="card-body">
                    <div class="dashboard-card-heading">
                        <div>
                            <p class="dashboard-eyebrow">Your profile</p>
                            <h2 id="dashboard-estimates-heading">Profile estimates</h2>
                        </div>
                    </div>

                    <dl class="dashboard-estimate-stats">
                        <div class="dashboard-estimate-stat">
                            <dt>Maintenance</dt>
                            <dd>
                                ~@Model.UserProfile.CalculateTdee(Model.CurrentDate).ToString("0")
                                <span>kcal/day</span>
                            </dd>
                        </div>

                        <div class="dashboard-estimate-stat">
                            <dt>BMR</dt>
                            <dd>
                                ~@Model.UserProfile.CalculateBmr(Model.CurrentDate).ToString("0")
                                <span>kcal/day</span>
                            </dd>
                        </div>

                        <div class="dashboard-estimate-stat">
                            <dt>BMI</dt>
                            <dd>@Model.UserProfile.BMI.ToString("0.0")</dd>
                        </div>

                        <div class="dashboard-estimate-stat">
                            <dt>Age</dt>
                            <dd>
                                @Model.UserProfile.CalculateAge(Model.CurrentDate)
                                <span>years</span>
                            </dd>
                        </div>
                    </dl>

                    <partial name="_GoalTimeline"
                             model="Model.GoalTimeline" />
                </div>
            </section>
        }

        <div class="dashboard-support-grid">
            <section class="dashboard-quick-actions"
                     aria-labelledby="dashboard-actions-heading">
                <div class="dashboard-card-heading">
                    <div>
                        <p class="dashboard-eyebrow">Shortcuts</p>
                        <h2 id="dashboard-actions-heading">Quick actions</h2>
                    </div>
                </div>

                <div class="dashboard-actions">
                    <a asp-page="/Diary/Create"
                       asp-route-date="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="dashboard-action">
                        <span class="dashboard-action-heading">
                            <svg class="dashboard-action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                            <strong>Log food</strong>
                        </span>
                        <span>Add something to today’s Diary</span>
                    </a>

                    <a asp-page="/Diary/Index"
                       asp-route-date="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="dashboard-action">
                        <span class="dashboard-action-heading">
                            <svg class="dashboard-action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <rect x="4" y="5.5" width="16" height="15" rx="2.5" />
                                <path d="M8 3.5v4M16 3.5v4M7.5 11h9M7.5 15h6" />
                            </svg>
                            <strong>Today’s Diary</strong>
                        </span>
                        <span>Review or update today’s entries</span>
                    </a>

                    <a asp-page="/Foods/Create"
                       class="dashboard-action">
                        <span class="dashboard-action-heading">
                            <svg class="dashboard-action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M8 4v7a3 3 0 0 1-3 3V4M5 4v6M8 4v6M5 14v6" />
                                <path d="M15 4v16M15 4c3 0 4 2.25 4 5s-1 4-4 4" />
                            </svg>
                            <strong>Add custom food</strong>
                        </span>
                        <span>Create a food you can reuse</span>
                    </a>

                    <a asp-page="/SavedMeals/Index"
                       class="dashboard-action">
                        <span class="dashboard-action-heading">
                            <svg class="dashboard-action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 20.25S4.5 16.1 4.5 9.5A4.25 4.25 0 0 1 12 6.75 4.25 4.25 0 0 1 19.5 9.5c0 6.6-7.5 10.75-7.5 10.75Z" />
                            </svg>
                            <strong>Saved Meals</strong>
                        </span>
                        <span>Log familiar combinations faster</span>
                    </a>
                </div>
            </section>

            <aside class="dashboard-comfy-note"
                   aria-labelledby="dashboard-comfy-note-heading">
                <p class="dashboard-eyebrow">A comfy note</p>
                <h2 id="dashboard-comfy-note-heading">
                    Keep today simple.
                </h2>
                <p>
                    Log what is useful, use shortcuts when they help,
                    and leave the rest of the day for living.
                </p>

                @if (Model.CapyAppearance != null)
                {
                    <a asp-page="/Customisation"
                       class="dashboard-capy-identity"
                       aria-label="Customise @Model.CapyAppearance.DisplayName">
                        <span class="dashboard-capy-frame" aria-hidden="true">
                            <partial name="_CapyAvatar"
                                     model="Model.CapyAppearance" />
                        </span>
                        <span>
                            <strong>@Model.CapyAppearance.DisplayName</strong>
                            <small>Customise Capy →</small>
                        </span>
                    </a>
                }
            </aside>
        </div>

    </div>
}
else
{
    <div class="home-landing">

        <div class="home-hero">

