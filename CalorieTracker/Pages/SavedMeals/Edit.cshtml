@page "{id:int}"
@model CalorieTracker.Pages.SavedMeals.EditModel
@{
    ViewData["Title"] = "Edit Saved Meal";
}

<h1>Edit Saved Meal</h1>
<p class="text-body-secondary">Rename it, or optionally replace its items from another logged Diary meal. Existing Diary history is not changed.</p>
<form method="post" class="form-shell">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" maxlength="80" />
    </div>
    <fieldset class="form-section">
        <legend>Replace items from Diary</legend>
        <div class="form-check mb-3">
            <input asp-for="Input.ReplaceItems" class="form-check-input" />
            <label asp-for="Input.ReplaceItems" class="form-check-label">Replace the saved items</label>
        </div>
        <p class="form-text">Leave this unchecked to keep the current items.</p>
        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="Input.SourceDate" class="form-label">Diary date</label>
                <input asp-for="Input.SourceDate" type="date" min="1900-01-01" max="2100-12-31" class="form-control" />
            </div>
            <div class="col-sm-6">
                <label asp-for="Input.SourceMeal" class="form-label">Diary meal</label>
                <select asp-for="Input.SourceMeal" class="form-select">
                    @foreach (var meal in CalorieTracker.Services.ValidationRules.MealTypes)
                    { <option value="@meal">@meal</option> }
                </select>
            </div>
        </div>
    </fieldset>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-page="./Details" asp-route-id="@Model.Input.Id" class="btn btn-secondary">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
