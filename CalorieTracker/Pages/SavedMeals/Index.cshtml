@page
@model CalorieTracker.Pages.SavedMeals.IndexModel
@{
    ViewData["Title"] = "Saved Meals";
}

<div class="saved-meals-page">
    @await Html.PartialAsync(
        "_ScenicPageHeader",
        new CalorieTracker.Models.ScenicPageHeaderModel(
            Title: "Saved Meals",
            Subtitle: "Your favourite combinations, ready when you are.",
            CssClass: "secondary-page-hero saved-meals-hero"))

    @if (Model.SavedMeals.Count == 0)
    {
        <section class="ct-card saved-meals-empty" aria-labelledby="savedMealsEmptyTitle">
            <div class="saved-meals-empty-icon" aria-hidden="true">♡</div>
            <div>
                <h2 id="savedMealsEmptyTitle">Nothing saved yet</h2>
                <p>Log a meal in your Diary, then save it so you can reuse the whole meal later.</p>
                <a asp-page="/Diary/Index" class="btn btn-outline-primary">← Back to Diary</a>
            </div>
        </section>
    }
    else
    {
        <div class="row g-3">
            @foreach (var meal in Model.SavedMeals)
            {
                <div class="col-12 col-lg-6">
                    <article class="card h-100"><div class="card-body">
                        <h2 class="h4">@meal.Name</h2>
                        <p class="text-body-secondary">@meal.Items.Count @(meal.Items.Count == 1 ? "item" : "items")</p>
                        <form method="post" asp-page-handler="Add" class="row g-2 align-items-end">
                            <input type="hidden" name="id" value="@meal.Id" />
                            <div class="col-sm-5">
                                <label class="form-label" for="saved-date-@meal.Id">Date</label>
                                <input id="saved-date-@meal.Id" name="date" type="date"
                                       value="@Model.DefaultDate.ToString("yyyy-MM-dd")"
                                       min="1900-01-01" max="2100-12-31" class="form-control" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label" for="saved-meal-@meal.Id">Meal</label>
                                <select id="saved-meal-@meal.Id" name="mealType" class="form-select">
                                    @foreach (var mealType in CalorieTracker.Services.ValidationRules.MealTypes)
                                    { <option value="@mealType">@mealType</option> }
                                </select>
                            </div>
                            <div class="col-sm-3"><button class="btn btn-primary w-100" type="submit">Add</button></div>
                        </form>
                        <div class="d-flex gap-2 mt-3">
                            <a asp-page="./Details" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="./Edit" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </div></article>
                </div>
            }
        </div>
    }

    @if (Model.SavedMeals.Count > 0)
    {
        <a asp-page="/Diary/Index" class="btn btn-outline-secondary saved-meals-back-link">← Back to Diary</a>
    }
</div>
