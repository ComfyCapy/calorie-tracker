@page
@model CalorieTracker.Pages.CustomisationModel
@using CalorieTracker.Services

@{
    ViewData["Title"] = "Customisation";

    var categories = new[]
    {
        new
        {
            Key = CapyCategories.Background,
            Name = "Background",
            Icon = "Icon-Background.png",
            Optional = false
        },
        new
        {
            Key = CapyCategories.Expression,
            Name = "Expression",
            Icon = "Icon-Expression.png",
            Optional = false
        },
        new
        {
            Key = CapyCategories.Clothes,
            Name = "Clothes",
            Icon = "Icon-Clothes.png",
            Optional = true
        },
        new
        {
            Key = CapyCategories.NeckAccessory,
            Name = "Neck Accessories",
            Icon = "Icon-NeckAccessory.png",
            Optional = true
        },
        new
        {
            Key = CapyCategories.HatHair,
            Name = "Hats & Hair",
            Icon = "Icon-HatHair.png",
            Optional = true
        },
        new
        {
            Key = CapyCategories.FaceAccessory,
            Name = "Face Accessories",
            Icon = "Icon-FaceAccessory.png",
            Optional = true
        }
    };

    Func<string, int?> getEquippedItemId = category =>
        category switch
        {
            CapyCategories.Background => Model.CapyAppearance?.BackgroundId,
            CapyCategories.Expression => Model.CapyAppearance?.ExpressionId,
            CapyCategories.Clothes => Model.CapyAppearance?.ClothesId,
            CapyCategories.NeckAccessory => Model.CapyAppearance?.NeckAccessoryId,
            CapyCategories.HatHair => Model.CapyAppearance?.HatHairId,
            CapyCategories.FaceAccessory => Model.CapyAppearance?.FaceAccessoryId,
            _ => null
        };
        var ownsGoldCrown = Model.OwnedItems
       .Any(item => item.Id == 14);
}

<div class="customisation-page"
     data-needs-provisioning="@(Model.NeedsProvisioning ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div id="capy-error" class="alert alert-danger" role="alert" hidden></div>

    <div class="text-center mb-4">

    <h1 class="capy-customisation-title">

        @if (!ownsGoldCrown)
        {
            <button type="button"
                    class="capy-secret-crown"
                    data-unlock-item-id="14"
                    aria-label="Unlock gold crown">
                👑
            </button>
        }

        <span>Customisation</span>

        @if (!ownsGoldCrown)
        {
            <button type="button"
                    class="capy-secret-crown"
                    data-unlock-item-id="14"
                    aria-label="Unlock gold crown">
                👑
            </button>
        }

    </h1>
        <p class="text-muted">
            Make your Comfy Capy your own.
        </p>
        <div id="capy-unlock-message"
             class="alert alert-success capy-unlock-message"
             role="status"
             hidden>
        </div>
    </div>

    @if (Model.CapyAppearance == null)
    {
        <div id="capy-provision-status" class="alert alert-info" role="status">
            Setting up your Comfy Capy…
        </div>
    }
    else
    {
        <div class="capy-customisation-layout">

            <section class="capy-preview-panel">

                <h2 class="capy-preview-title">
                    @(Model.Username)'s Comfy Capy
                </h2>

                <div class="capy-preview">
                    <partial name="_CapyAvatar"
                             model="Model.CapyAppearance" />
                </div>

            </section>

            <section class="capy-inventory">

                <h2 class="visually-hidden">Capy inventory</h2>

                <div class="d-flex justify-content-end mb-2">
                    <div class="btn-group btn-group-sm"
                         role="group"
                         aria-label="Capy inventory filter">

                        <button type="button"
                                class="btn btn-outline-secondary capy-inventory-filter"
                                data-filter="owned"
                                aria-pressed="false">
                            Owned only
                        </button>

                        <button type="button"
                                class="btn btn-primary capy-inventory-filter"
                                data-filter="all"
                                aria-pressed="true">
                            All items
                        </button>

                    </div>
                </div>

                @foreach (var category in categories)
                {
                    var equippedItemId =
                        getEquippedItemId(category.Key);

                    var categoryItems = Model.CatalogueItems
                        .Where(item =>
                            item.Category == category.Key)
                        .ToList();

                    var ownedItemIds = Model.OwnedItems
                        .Select(item => item.Id)
                        .ToHashSet();

                    <div class="capy-inventory-row"
                         role="group"
                         aria-labelledby="capy-category-@category.Key">

                        <div class="capy-category-icon"
                             title="@category.Name"
                             aria-hidden="true">

                            <img src="/images/capy/ui/@category.Icon"
                                 alt="" />

                        </div>

                        <h3 id="capy-category-@category.Key"
                            class="visually-hidden">
                            @category.Name
                        </h3>

                        <div class="capy-item-list">

                            @if (category.Optional)
                            {
                                <button type="button"
                                        class="capy-item-tile capy-none-tile @(equippedItemId == null ? "is-equipped" : "")"
                                        data-category="@category.Key"
                                        data-item-id=""
                                        title="None"
                                        aria-label="No @category.Name"
                                        aria-pressed="@(equippedItemId == null ? "true" : "false")">

                                    <span>×</span>

                                </button>
                            }

                            @foreach (var item in categoryItems)
                            {
                                var isOwned = ownedItemIds.Contains(item.Id);

                                if (isOwned)
                                {
                                    <button type="button"
                                            class="capy-item-tile @(equippedItemId == item.Id ? "is-equipped" : "")"
                                            data-category="@category.Key"
                                            data-item-id="@item.Id"
                                            title="@item.Name"
                                            aria-label="@item.Name"
                                            aria-pressed="@(equippedItemId == item.Id ? "true" : "false")">

                                        <img src="@item.ImagePath"
                                             alt="@item.Name" />

                                    </button>
                                }
                                else
                                {
                                    <div class="capy-item-tile capy-item-locked"
                                         title="@item.Name — Locked"
                                         role="img"
                                         aria-label="@item.Name, locked">

                                        <img src="@item.ImagePath"
                                             alt="" />

                                        <span class="capy-lock-icon"
                                              aria-hidden="true">
                                            🔒
                                        </span>

                                    </div>
                                }
                            }

                        </div>

                    </div>
                }

            </section>

        </div>

        <section class="capy-theme-section">
            <h2 class="capy-theme-title">Theme</h2>

            <p class="text-muted mb-3">
                Choose how CalorieTracker looks.
            </p>

            <div class="capy-theme-options">

                <button type="button"
                        class="capy-theme-option theme-option"
                        data-theme="light"
                        aria-pressed="false"
                        disabled="@(!Model.HasUserProfile)">
                    <span class="capy-theme-option-title">
                        Light
                    </span>

                    <span class="capy-theme-option-description">
                        Always use light mode
                    </span>
                </button>

                <button type="button"
                        class="capy-theme-option theme-option"
                        data-theme="dark"
                        aria-pressed="false"
                        disabled="@(!Model.HasUserProfile)">
                    <span class="capy-theme-option-title">
                        Dark
                    </span>

                    <span class="capy-theme-option-description">
                        Always use dark mode
                    </span>
                </button>

                <button type="button"
                        class="capy-theme-option theme-option"
                        data-theme="system"
                        aria-pressed="false"
                        disabled="@(!Model.HasUserProfile)">
                    <span class="capy-theme-option-title">
                        System
                    </span>

                    <span class="capy-theme-option-description">
                        Match your device setting
                    </span>
                </button>

            </div>
            @if (!Model.HasUserProfile)
            {
                <p class="text-body-secondary small mt-2 mb-0">
                    Complete your profile to choose and save an account theme.
                </p>
            }
        </section>
    }

</div>


@section Scripts
{
    <script src="~/js/customisation.js" asp-append-version="true"></script>
}
