@page
@model CalorieTracker.Pages.CustomisationModel
@using CalorieTracker.Services

@{
    ViewData["Title"] = "Customisation";
    ViewData["UsesScenicHeader"] = true;

    var categories = new[]
    {
        new
        {
            Key = "outfits",
            Name = "Outfits",
            Icon = "Icon-Clothes.png",
            ItemCategories = new[] { CapyCategories.Clothes },
            OptionalCategories = new[] { CapyCategories.Clothes }
        },
        new
        {
            Key = "face-accessories",
            Name = "Face Accessories",
            Icon = "Icon-FaceAccessory.png",
            ItemCategories = new[] { CapyCategories.FaceAccessory },
            OptionalCategories = new[] { CapyCategories.FaceAccessory }
        },
        new
        {
            Key = "neck-accessories",
            Name = "Neck Accessories",
            Icon = "Icon-NeckAccessory.png",
            ItemCategories = new[] { CapyCategories.NeckAccessory },
            OptionalCategories = new[] { CapyCategories.NeckAccessory }
        },
        new
        {
            Key = "hats",
            Name = "Hats",
            Icon = "Icon-HatHair.png",
            ItemCategories = new[] { CapyCategories.HatHair },
            OptionalCategories = new[] { CapyCategories.HatHair }
        },
        new
        {
            Key = "backgrounds",
            Name = "Backgrounds",
            Icon = "Icon-Background.png",
            ItemCategories = new[] { CapyCategories.Background },
            OptionalCategories = Array.Empty<string>()
        },
        new
        {
            Key = "colours",
            Name = "Expressions",
            Icon = "Icon-Expression.png",
            ItemCategories = new[] { CapyCategories.Expression },
            OptionalCategories = Array.Empty<string>()
        },
        new
        {
            Key = "titles",
            Name = "Titles",
            Icon = "Icon-Expression.png",
            ItemCategories = Array.Empty<string>(),
            OptionalCategories = Array.Empty<string>()
        }
    };

    Func<string, int?> getEquippedItemId = category =>
        category switch
        {
            CapyCategories.Background => Model.CapyAppearance?.BackgroundId,
            CapyCategories.Expression => Model.CapyAppearance?.ExpressionId,
            CapyCategories.Clothes => Model.CapyAppearance?.ClothesId,
            CapyCategories.NeckAccessory => Model.CapyAppearance?.NeckAccessoryId,
            CapyCategories.HatHair => Model.CapyAppearance?.HatHairId,
            CapyCategories.FaceAccessory => Model.CapyAppearance?.FaceAccessoryId,
            _ => null
        };

    var ownedItemIds = Model.OwnedItems
        .Select(item => item.Id)
        .ToHashSet();
    var unlockedCount = Model.OwnedItems.Count;
    var ownsGoldCrown = ownedItemIds.Contains(14);
    var displayedCategories = Model.SelectedCategory == "all"
        ? categories
        : categories.Where(category => category.Key == Model.SelectedCategory);

    string getCosmeticDisplayName(CalorieTracker.Models.CapyItem? item) =>
        item?.Id switch
        {
            4 => "Aviators",
            5 => "Green Scarf",
            6 => "Green Bow Tie",
            null => "None",
            _ => item.Name
        };
}

<div class="customisation-page"
     data-needs-provisioning="@(Model.NeedsProvisioning ? "true" : "false")">
    @Html.AntiForgeryToken()

    @await Html.PartialAsync(
        "_ScenicPageHeader",
        new CalorieTracker.Models.ScenicPageHeaderModel(
            Title: "Customisation",
            Eyebrow: "CUSTOMISATION",
            ArtworkPath: "~/images/brand/dashboard-hero-capy.png",
            ArtworkAlt: "",
            ArtworkIsDecorative: true,
            CssClass: "secondary-page-hero",
            UseFullBleedArtwork: true))

    <div id="capy-error" class="alert alert-danger" role="alert" hidden></div>
    <div id="capy-unlock-message"
         class="alert alert-success capy-unlock-message"
         role="status"
         hidden>
    </div>

    @if (Model.CapyAppearance != null)
    {
        <section class="ct-card capy-companion-summary" aria-label="Your Comfy Capy summary">
            <div>
                <p class="ct-eyebrow">Your companion</p>
                <h2>@Model.CapyAppearance.DisplayName</h2>
                <p>Small steps still move you forward.</p>
            </div>
            <div class="capy-companion-summary-count">
                <span>Cosmetics unlocked</span>
                <strong>@unlockedCount</strong>
            </div>
        </section>
    }

    @if (Model.CapyAppearance == null)
    {
        <div id="capy-provision-status" class="ct-card capy-provision-card" role="status">
            <strong>Making your companion comfortable…</strong>
            <span>Your Comfy Capy collection will be ready in a moment.</span>
        </div>
    }
    else
    {
        <div class="capy-customisation-layout">
            <main class="capy-customisation-main">
                <nav class="capy-category-tabs" aria-label="Cosmetic categories">
                    <a class="capy-category-tab @(Model.SelectedCategory == "all" ? "is-selected" : "")"
                       data-category-filter="all"
                       asp-route-category="all"
                       asp-route-inventory="@Model.SelectedInventoryFilter"
                       aria-current="@(Model.SelectedCategory == "all" ? "page" : null)">
                        All items
                    </a>

                    @foreach (var category in categories)
                    {
                        <a class="capy-category-tab @(Model.SelectedCategory == category.Key ? "is-selected" : "")"
                           data-category-filter="@category.Key"
                           asp-route-category="@category.Key"
                           asp-route-inventory="@Model.SelectedInventoryFilter"
                           aria-current="@(Model.SelectedCategory == category.Key ? "page" : null)">
                            @category.Name
                        </a>
                    }
                </nav>

                <section class="ct-card capy-collection-card" aria-labelledby="capyCollectionTitle">
                    <header class="capy-collection-heading">
                        <div>
                            <p class="ct-eyebrow">Your collection</p>
                            <h2 id="capyCollectionTitle">Choose something comfy</h2>
                        </div>

                        <div class="capy-inventory-filters"
                             role="group"
                             aria-label="Capy inventory filter">
                            <a class="btn btn-sm @(Model.SelectedInventoryFilter == "owned" ? "btn-primary" : "btn-outline-secondary") capy-inventory-filter"
                               asp-route-category="@Model.SelectedCategory"
                               asp-route-inventory="owned"
                               aria-current="@(Model.SelectedInventoryFilter == "owned" ? "page" : null)">
                                Unlocked only
                            </a>
                            <a class="btn btn-sm @(Model.SelectedInventoryFilter == "all" ? "btn-primary" : "btn-outline-secondary") capy-inventory-filter"
                               asp-route-category="@Model.SelectedCategory"
                               asp-route-inventory="all"
                               aria-current="@(Model.SelectedInventoryFilter == "all" ? "page" : null)">
                                Show all
                            </a>
                        </div>
                        @if (!ownsGoldCrown)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary capy-secret-crown"
                                    data-unlock-item-id="14"
                                    aria-label="Reveal hidden cosmetic">
                                <span aria-hidden="true">👑</span>
                            </button>
                        }
                    </header>
                </section>

                <div class="capy-inventory">
                        @foreach (var category in displayedCategories)
                        {
                            var categoryItems = Model.CatalogueItems
                                .Where(item => category.ItemCategories.Contains(item.Category))
                                .ToList();
                            var totalPages = Math.Max(
                                1,
                                (int)Math.Ceiling(categoryItems.Count /
                                    (double)CalorieTracker.Pages.CustomisationModel.CategoryPageSize));

                            <section class="ct-card capy-inventory-group capy-category-card"
                                     id="capy-category-@category.Key"
                                     data-capy-category-group="@category.Key"
                                     data-capy-page-size="@CalorieTracker.Pages.CustomisationModel.CategoryPageSize"
                                     aria-labelledby="capy-category-title-@category.Key">
                                <header class="capy-inventory-group-heading">
                                    <h3 id="capy-category-title-@category.Key">@category.Name</h3>
                                    @if (totalPages > 1)
                                    {
                                        <nav class="capy-category-pagination"
                                             aria-label="@category.Name pages"
                                             data-capy-category-pagination>
                                            <button type="button"
                                                    data-capy-page-previous
                                                    aria-label="Previous @category.Name page"
                                                    disabled>‹</button>
                                            <span data-capy-page-indicator aria-live="polite">1 / @totalPages</span>
                                            <button type="button"
                                                    data-capy-page-next
                                                    aria-label="Next @category.Name page">›</button>
                                        </nav>
                                    }
                                </header>

                                @if (categoryItems.Count == 0)
                                {
                                    <div class="capy-category-empty">
                                        <strong>No @category.Name.ToLowerInvariant() are available yet.</strong>
                                        <span>This collection will stay calm and uncluttered until there is something real to choose.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="capy-item-grid">
                                        @foreach (var optionalCategory in category.OptionalCategories)
                                        {
                                            var equippedItemId = getEquippedItemId(optionalCategory);
                                            var noneLabel = optionalCategory switch
                                            {
                                                CapyCategories.Clothes => "No outfit",
                                                CapyCategories.HatHair => "No hat",
                                                CapyCategories.FaceAccessory => "No face accessory",
                                                CapyCategories.NeckAccessory => "No neck accessory",
                                                _ => "None"
                                            };

                                            <button type="button"
                                                    class="capy-item-tile capy-none-tile @(equippedItemId == null ? "is-equipped" : "")"
                                                    data-category="@optionalCategory"
                                                    data-item-id=""
                                                    title="@noneLabel"
                                                    aria-label="@noneLabel"
                                                    aria-pressed="@(equippedItemId == null ? "true" : "false")">
                                                <span class="capy-item-visual" aria-hidden="true">×</span>
                                                <span class="capy-item-details">
                                                    <strong>@noneLabel</strong>
                                                    <span class="capy-item-status">@(equippedItemId == null ? "Equipped" : "Unlocked")</span>
                                                </span>
                                            </button>
                                        }

                                        @for (var itemIndex = 0; itemIndex < categoryItems.Count; itemIndex++)
                                        {
                                            var item = categoryItems[itemIndex];
                                            var isOwned = ownedItemIds.Contains(item.Id);
                                            var isEquipped = getEquippedItemId(item.Category) == item.Id;
                                            var displayName = getCosmeticDisplayName(item);
                                            var isInitiallyHidden = itemIndex >= CalorieTracker.Pages.CustomisationModel.CategoryPageSize;

                                            if (isOwned)
                                            {
                                                <button type="button"
                                                        class="capy-item-tile @(isEquipped ? "is-equipped" : "")"
                                                        data-capy-page-item
                                                        data-category="@item.Category"
                                                        data-item-id="@item.Id"
                                                        hidden="@isInitiallyHidden"
                                                        title="@displayName"
                                                        aria-label="@displayName, @(isEquipped ? "equipped" : "unlocked")"
                                                        aria-pressed="@(isEquipped ? "true" : "false")">
                                                    <span class="capy-item-visual">
                                                        <img src="@item.ImagePath" alt="" />
                                                    </span>
                                                    <span class="capy-item-details">
                                                        <strong>@displayName</strong>
                                                        <span class="capy-item-status">@(isEquipped ? "Equipped" : "Unlocked")</span>
                                                    </span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="capy-item-tile capy-item-locked"
                                                     data-capy-page-item
                                                     hidden="@isInitiallyHidden"
                                                     title="@displayName — Locked"
                                                     role="img"
                                                     aria-label="@displayName, locked. Secret unlock requirement.">
                                                    <span class="capy-item-visual">
                                                        <img src="@item.ImagePath" alt="" />
                                                        <span class="capy-lock-icon" aria-hidden="true">🔒</span>
                                                    </span>
                                                    <span class="capy-item-details">
                                                        <strong>@displayName</strong>
                                                        <span class="capy-item-status">Locked</span>
                                                    </span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </section>
                        }
                </div>

                <section class="ct-card capy-collection-summary" aria-labelledby="capyCollectionSummaryTitle">
                    <div class="capy-collection-summary-copy">
                        <div>
                            <p class="ct-eyebrow">Your collection</p>
                            <h2 id="capyCollectionSummaryTitle">@unlockedCount cosmetics unlocked</h2>
                        </div>
                    </div>
                </section>
            </main>

            <aside class="capy-customisation-sidebar" aria-label="Your Comfy Capy">
                <section class="ct-card capy-preview-panel" aria-labelledby="capyPreviewTitle">
                    <header class="capy-sidebar-heading">
                        <div>
                            <p class="ct-eyebrow">Right now</p>
                            <h2 id="capyPreviewTitle">Live Capy preview</h2>
                        </div>
                        <span class="capy-live-indicator">Live</span>
                    </header>

                    <div class="capy-preview" aria-label="Preview of @Model.CapyAppearance.DisplayName">
                        <partial name="_CapyAvatar" model="Model.CapyAppearance" />
                    </div>

                    <details class="capy-name-editor">
                        <summary>
                            @(string.IsNullOrWhiteSpace(Model.CapyAppearance.Name)
                                ? "Name your Capy"
                                : $"Rename {Model.CapyAppearance.DisplayName}")
                        </summary>

                        <form method="post"
                              asp-page-handler="Rename"
                              class="capy-name-form">
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger"
                                 role="alert"></div>

                            <label asp-for="CapyName" class="form-label">Capy name</label>
                            <input asp-for="CapyName"
                                   class="form-control"
                                   maxlength="40"
                                   placeholder="Comfy Capy"
                                   autocomplete="nickname" />
                            <div class="form-text">Clear the name to restore “Comfy Capy”.</div>
                            <span asp-validation-for="CapyName" class="text-danger"></span>
                            <button type="submit" class="btn btn-outline-primary mt-2">Save name</button>
                        </form>
                    </details>
                </section>

                <section class="ct-card capy-loadout-card" aria-labelledby="capyLoadoutTitle">
                    <h2 id="capyLoadoutTitle">Current loadout</h2>
                    <dl class="capy-loadout-list">
                        <div><dt>Hat</dt><dd data-capy-loadout="@CapyCategories.HatHair">@getCosmeticDisplayName(Model.CapyAppearance.HatHair)</dd></div>
                        <div><dt>Outfit</dt><dd data-capy-loadout="@CapyCategories.Clothes">@getCosmeticDisplayName(Model.CapyAppearance.Clothes)</dd></div>
                        <div><dt>Neck accessory</dt><dd data-capy-loadout="@CapyCategories.NeckAccessory">@getCosmeticDisplayName(Model.CapyAppearance.NeckAccessory)</dd></div>
                        <div><dt>Face accessory</dt><dd data-capy-loadout="@CapyCategories.FaceAccessory">@getCosmeticDisplayName(Model.CapyAppearance.FaceAccessory)</dd></div>
                        <div><dt>Background</dt><dd data-capy-loadout="@CapyCategories.Background">@getCosmeticDisplayName(Model.CapyAppearance.Background)</dd></div>
                        <div><dt>Expression</dt><dd data-capy-loadout="@CapyCategories.Expression">@getCosmeticDisplayName(Model.CapyAppearance.Expression)</dd></div>
                        <div><dt>Title</dt><dd>Not available</dd></div>
                    </dl>
                </section>

                <section class="ct-card capy-saved-outfits" aria-labelledby="savedOutfitsTitle">
                    <h2 id="savedOutfitsTitle">Saved outfits</h2>
                    <form method="post" asp-page-handler="SaveOutfit" class="capy-outfit-save-form">
                        <label asp-for="OutfitName" class="visually-hidden">Outfit name</label>
                        <input asp-for="OutfitName" class="form-control" maxlength="60" placeholder="Outfit name" required />
                        <button type="submit" class="btn btn-outline-primary">Save current</button>
                    </form>
                    @if (Model.SavedOutfits.Count == 0)
                    {
                        <p class="text-muted mb-0">Save a look to return to it in one step.</p>
                    }
                    else
                    {
                        <ul class="capy-saved-outfit-list">
                            @foreach (var outfit in Model.SavedOutfits)
                            {
                                <li>
                                    <strong>@outfit.Name</strong>
                                    <div>
                                        <form method="post" asp-page-handler="EquipOutfit"><input type="hidden" name="outfitId" value="@outfit.Id" /><button type="submit" class="btn btn-sm btn-outline-primary">Equip</button></form>
                                        <form method="post" asp-page-handler="DeleteOutfit"><input type="hidden" name="outfitId" value="@outfit.Id" /><button type="submit" class="btn btn-sm btn-outline-secondary">Delete</button></form>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <aside class="ct-card capy-motivation-card">
                    <span aria-hidden="true">🌿</span>
                    <div>
                        <p class="ct-eyebrow">A Comfy reminder</p>
                        <strong>Progress isn’t perfection.</strong>
                    </div>
                </aside>

                <section class="ct-card capy-theme-section" aria-labelledby="capyThemeTitle">
                    <h2 id="capyThemeTitle" class="capy-theme-title">Theme</h2>
                    <p class="text-muted">Choose how Comfy Capy Calories looks.</p>

                    <div class="capy-theme-options">
                        <button type="button"
                                class="capy-theme-option theme-option"
                                data-theme="light"
                                aria-pressed="false">
                            <span class="capy-theme-option-title">Light</span>
                            <span class="capy-theme-option-description">Always use light mode</span>
                        </button>
                        <button type="button"
                                class="capy-theme-option theme-option"
                                data-theme="dark"
                                aria-pressed="false">
                            <span class="capy-theme-option-title">Dark</span>
                            <span class="capy-theme-option-description">Always use dark mode</span>
                        </button>
                        <button type="button"
                                class="capy-theme-option theme-option"
                                data-theme="system"
                                aria-pressed="false">
                            <span class="capy-theme-option-title">System</span>
                            <span class="capy-theme-option-description">Match your device setting</span>
                        </button>
                    </div>

                    @if (!Model.HasUserProfile)
                    {
                        <p class="text-body-secondary small mt-2 mb-0">
                            Your browser theme is saved now; complete your profile to also save it to your account.
                        </p>
                    }
                </section>
            </aside>
        </div>
    }
</div>

@section Scripts
{
    <script src="~/js/customisation.js" asp-append-version="true"></script>
}
