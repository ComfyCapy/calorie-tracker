@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CalorieTracker.Data
@using CalorieTracker.Models
@using CalorieTracker.Services

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject ProgressionService ProgressionService
@inject IUserLocalTimeProvider UserLocalTime
@inject ILoggerFactory LoggerFactory

<ul class="navbar-nav account-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var greetingName = string.IsNullOrWhiteSpace(currentUser?.FirstName)
            ? "there"
            : currentUser.FirstName;
        var userId = UserManager.GetUserId(User);

        UserCapyAppearance? navbarCapy = null;
        int? progressionLevel = null;

        if (currentUser != null)
        {
            navbarCapy = await DbContext.UserCapyAppearances
                .Include(appearance => appearance.Background)
                .Include(appearance => appearance.Expression)
                .Include(appearance => appearance.Clothes)
                .Include(appearance => appearance.NeckAccessory)
                .Include(appearance => appearance.HatHair)
                .Include(appearance => appearance.FaceAccessory)
                .FirstOrDefaultAsync(appearance =>
                    appearance.UserId == currentUser.Id);
        }

        if (userId != null)
        {
            try
            {
                progressionLevel = (await ProgressionService
                    .GetSummaryAsync(
                        userId,
                        UserLocalTime.Today,
                        Context.RequestAborted))
                    .Level
                    .CurrentLevel;
            }
            catch (Exception exception)
                when (!Context.RequestAborted.IsCancellationRequested)
            {
                LoggerFactory
                    .CreateLogger("AccountNavigation")
                    .LogError(
                        exception,
                        "Optional account progression summary failed for " +
                        "user {UserId}; account navigation will continue " +
                        "without a level.",
                        userId);
            }
        }

        <li class="nav-item account-nav-item">
            <div class="account-nav-summary dropdown">
                @if (navbarCapy != null)
                {
                    <a asp-area=""
                       asp-page="/Customisation"
                       class="navbar-capy"
                       title="Customise Capy"
                       aria-label="Customise Capy">
                        <partial name="_CapyAvatar"
                                 model="navbarCapy" />
                    </a>
                }

                <button class="nav-link dropdown-toggle account-nav-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Open account menu">
                        <span class="account-nav-copy">
                            <span class="account-nav-name">@greetingName</span>
                            @if (progressionLevel.HasValue)
                            {
                                <span class="account-nav-level">Level @progressionLevel.Value</span>
                            }
                        </span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end account-nav-menu">
                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-page="/Customisation">
                            Customise Capy
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           asp-area="Identity"
                           asp-page="/Account/Manage/Index">
                            Account settings
                        </a>
                    </li>

                    <li class="account-nav-logout">
                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="dropdown-item">
                                Log out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>
