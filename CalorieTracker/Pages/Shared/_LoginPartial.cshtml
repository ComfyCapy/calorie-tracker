@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CalorieTracker.Data
@using CalorieTracker.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<ul class="navbar-nav account-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var greetingName = string.IsNullOrWhiteSpace(currentUser?.FirstName)
            ? "there"
            : currentUser.FirstName;

        UserCapyAppearance? navbarCapy = null;

        if (currentUser != null)
        {
            navbarCapy = await DbContext.UserCapyAppearances
                .Include(appearance => appearance.Background)
                .Include(appearance => appearance.Expression)
                .Include(appearance => appearance.Clothes)
                .Include(appearance => appearance.NeckAccessory)
                .Include(appearance => appearance.HatHair)
                .Include(appearance => appearance.FaceAccessory)
                .FirstOrDefaultAsync(appearance =>
                    appearance.UserId == currentUser.Id);
        }

        <li class="nav-item account-nav-item">
            <div class="account-nav-summary dropdown dropup">
                @if (navbarCapy != null)
                {
                    <a asp-area=""
                       asp-page="/Customisation"
                       class="navbar-capy"
                       title="Customise Capy"
                       aria-label="Customise Capy">
                        <partial name="_CapyAvatar"
                                 model="navbarCapy" />
                    </a>
                }

                <button class="nav-link dropdown-toggle account-nav-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Open account menu">
                    <span class="account-nav-copy">
                        <span class="account-nav-greeting">Hello</span>
                        <span class="account-nav-name">@greetingName!</span>
                    </span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end account-nav-menu">
                    <li>
                        <a class="dropdown-item"
                           asp-area=""
                           asp-page="/Customisation">
                            Customise Capy
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           asp-area="Identity"
                           asp-page="/Account/Manage/Index">
                            Account settings
                        </a>
                    </li>

                    <li class="account-nav-logout">
                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                            <button type="submit"
                                    class="dropdown-item">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>
