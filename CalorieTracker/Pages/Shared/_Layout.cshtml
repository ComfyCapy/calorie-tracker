@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CalorieTracker.Data

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    string? accountTheme = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = UserManager.GetUserId(User);

        if (userId != null)
        {
            accountTheme = await DbContext.UserProfiles
                .Where(profile => profile.UserId == userId)
                .Select(profile => profile.ThemePreference)
                .FirstOrDefaultAsync();
        }
    }

    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalorieTracker</title>
    <script>
            (() => {
                const accountTheme = "@(accountTheme?.ToLowerInvariant() ?? "")";
                const isAuthenticated =
                        @(User.Identity?.IsAuthenticated == true ? "true" : "false");

                let anonymousTheme = "system";
                if (!isAuthenticated) {
                    try { anonymousTheme = localStorage.getItem("theme") || "system"; } catch { }
                }
                const savedTheme =
                    isAuthenticated
                        ? accountTheme || "system"
                        : (["light", "dark", "system"].includes(anonymousTheme) ? anonymousTheme : "system");

                let themeToApply = savedTheme;

            if (savedTheme === "system") {
                themeToApply =
                window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
                }

            document.documentElement.setAttribute(
            "data-bs-theme",
            themeToApply
            );

            document.documentElement.setAttribute(
            "data-theme-preference",
            savedTheme
            );
            })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CalorieTracker.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    CalorieTracker
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="navbarSupportedContent" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Index"
                               aria-current="@(currentPage == "/Index" ? "page" : null)">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Foods/Index"
                                   aria-current="@(currentPage?.StartsWith("/Foods", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)">
                                    Foods
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-page="/Diary/Index"
                                   aria-current="@(currentPage?.StartsWith("/Diary", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)">
                                    Diary
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-page="/Profile/Index"
                                   aria-current="@(currentPage?.StartsWith("/Profile", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)">
                                    Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["UiStatusMessage"] is string statusMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @statusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 · CalorieTracker · A Comfy Capy project ·
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <form id="themeAntiForgeryForm" method="post" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    <script>
            document.querySelectorAll(".theme-option").forEach(button => {
                button.addEventListener("click", async () => {
                    const selectedTheme = button.dataset.theme;

                    // Apply and cache the theme immediately.
                    if (!@(User.Identity?.IsAuthenticated == true ? "true" : "false")) {
                        try { localStorage.setItem("theme", selectedTheme); } catch { }
                    }

                    let themeToApply = selectedTheme;

                    if (selectedTheme === "system") {
                        themeToApply =
                            window.matchMedia("(prefers-color-scheme: dark)").matches
                                ? "dark"
                                : "light";
                    }

                    document.documentElement.setAttribute(
                        "data-bs-theme",
                        themeToApply
                    );

                    document.documentElement.setAttribute(
                        "data-theme-preference",
                        selectedTheme
                    );

                    // If logged in, also save the preference to the account.
                    @if (User.Identity?.IsAuthenticated == true)
                        {
                            <text>
                                    const antiForgeryToken =
                                    document.querySelector(
                                    '#themeAntiForgeryForm input[name="__RequestVerificationToken"]'
                                    ).value;

                                    const themeForServer =
                                    selectedTheme.charAt(0).toUpperCase() +
                                    selectedTheme.slice(1);
                                    try {
                                        const response = await fetch('@Url.Page("/Profile/Index", "Theme")', {
                                            method: "POST",
                                            headers: {
                                                "Content-Type": "application/x-www-form-urlencoded",
                                                "X-CSRF-TOKEN": antiForgeryToken
                                            },
                                            body: new URLSearchParams({
                                                theme: themeForServer
                                            })
                                        });

                                        if (!response.ok) {
                                            console.error(
                                                "Theme preference save failed.",
                                                response.status,
                                                await response.text()
                                            );
                                        }
                                    }
                                    catch (error) {
                                        console.error(
                                            "Unable to save theme preference.",
                                            error
                                        );
                            }
                            </text>
                    }
                    });
            });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
