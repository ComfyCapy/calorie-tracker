@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CalorieTracker.Data
@using CalorieTracker.Services

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    string? accountTheme = null;

    if (isAuthenticated)
    {
        var userId = UserManager.GetUserId(User);

        if (userId != null)
        {
            accountTheme = await DbContext.UserProfiles
                .Where(profile => profile.UserId == userId)
                .Select(profile => profile.ThemePreference)
                .FirstOrDefaultAsync();
        }
    }

    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var pageTitle = ViewData["Title"]?.ToString();
    var metaDescription = ViewData["MetaDescription"]?.ToString()
        ?? "Approachable calorie and nutrition tracking with a customisable Comfy Capy.";
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString();
    var robots = ViewData["Robots"]?.ToString() ?? "noindex,follow";
}

<!DOCTYPE html>
<html lang="en"
      data-time-zone-cookie="@UserLocalTimeProvider.TimeZoneCookieName"
      data-time-zone-reload="@(HttpMethods.IsGet(Context.Request.Method) ? "true" : "false")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "Comfy Capy Calories" : $"{pageTitle} · Comfy Capy Calories")</title>
    <meta name="application-name" content="Comfy Capy Calories" />
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robots" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <meta name="theme-color" content="#7b61a8" />
    <link rel="icon" type="image/png" href="~/images/capy/expressions/Capy-Base.png" />
    <link rel="apple-touch-icon" href="~/images/capy/expressions/Capy-Base.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" />
    <script src="~/js/browser-time-zone.js" asp-append-version="true"></script>
    <script>
        (() => {
            try {
                if (sessionStorage.getItem("comfyCapy.developmentBannerDismissed") === "true") {
                    document.documentElement.dataset.developmentBannerDismissed = "true";
                }
            }
            catch { }
        })();
    </script>
    <script>
            (() => {
                const accountTheme = "@(accountTheme?.ToLowerInvariant() ?? "")";

                const validThemes = ["light", "dark", "system"];
                let storedTheme = "";
                try {
                    storedTheme = localStorage.getItem("theme")?.toLowerCase() || "";
                } catch { }

                // Theme is a browser preference. The account value remains a fallback
                // for a new browser and continues to be synchronised for signed-in users.
                const savedTheme = validThemes.includes(storedTheme)
                    ? storedTheme
                    : (validThemes.includes(accountTheme) ? accountTheme : "system");

                try { localStorage.setItem("theme", savedTheme); } catch { }

                let themeToApply = savedTheme;

            if (savedTheme === "system") {
                themeToApply =
                window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
                }

            document.documentElement.setAttribute(
            "data-bs-theme",
            themeToApply
            );

            document.documentElement.setAttribute(
            "data-theme-preference",
            savedTheme
            );
            })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CalorieTracker.styles.css" asp-append-version="true" />
</head>

<body class="@(isAuthenticated ? "app-shell-body" : "public-shell-body")">
    <div class="@(isAuthenticated ? "app-shell" : "public-shell")">
        @if (isAuthenticated)
        {
            <aside id="appSidebar"
                   class="offcanvas-lg offcanvas-start app-sidebar"
                   tabindex="-1"
                   aria-labelledby="appSidebarLabel">
                <div class="offcanvas-header app-sidebar-mobile-heading">
                    <h2 id="appSidebarLabel" class="h5 mb-0">Navigation</h2>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="offcanvas"
                            data-bs-target="#appSidebar"
                            aria-label="Close navigation"></button>
                </div>

                <div class="offcanvas-body app-sidebar-body">
                    <div class="app-sidebar-brand">
                        <span class="navbar-brand">
                            <img class="navbar-brand-mark"
                                 src="~/images/capy/expressions/Capy-Base.png"
                                 width="40"
                                 height="40"
                                 alt="" />
                            <span>Comfy Capy Calories</span>
                        </span>
                        <span class="app-brand-tagline">Tracking made comfier.</span>
                    </div>

                    <partial name="_AppNavigation" />

                    <div class="app-sidebar-account">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </aside>
        }

        <div class="shell-main @(isAuthenticated ? "app-shell-main" : "public-shell-main")">
            @if (isAuthenticated)
            {
                <nav class="navbar app-mobile-header" aria-label="Mobile application navigation">
                    <button class="navbar-toggler app-mobile-menu-button"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#appSidebar"
                            aria-controls="appSidebar"
                            aria-label="Open navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <span class="app-mobile-brand">
                        <img class="navbar-brand-mark"
                             src="~/images/capy/expressions/Capy-Base.png"
                             width="32"
                             height="32"
                             alt="" />
                        <span>Comfy Capy Calories</span>
                    </span>
                </nav>
            }

            <header>
                @if (!isAuthenticated)
                {
                    <nav class="navbar navbar-expand-sm navbar-toggleable-sm public-navbar border-bottom box-shadow">
                        <div class="container">
                            <span class="navbar-brand">
                                <img class="navbar-brand-mark"
                                     src="~/images/capy/expressions/Capy-Base.png"
                                     width="32"
                                     height="32"
                                     alt="" />
                                <span>Comfy Capy Calories</span>
                            </span>

                            <button class="navbar-toggler"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#navbarSupportedContent"
                                    aria-controls="navbarSupportedContent"
                                    aria-expanded="false"
                                    aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <div id="navbarSupportedContent" class="navbar-collapse collapse d-sm-inline-flex justify-content-end flex-grow-1">
                                <partial name="_LoginPartial" />
                            </div>
                        </div>
                    </nav>
                }

                <div id="developmentBanner"
                     class="development-banner"
                     role="status"
                     aria-labelledby="developmentBannerMessage"
                     data-development-banner>
                    <div class="@(isAuthenticated ? "app-content-width" : "container") development-banner-inner">
                        <span class="development-banner-icon" aria-hidden="true">🚧</span>
                        <p id="developmentBannerMessage" class="development-banner-message">
                            Comfy Capy Calories is in active development. Things may change,
                            and you might encounter the occasional bug while we keep improving
                            the app.
                        </p>
                        <a class="development-banner-link"
                           asp-area=""
                           asp-page="/Feedback">
                            Send feedback →
                        </a>
                        <button type="button"
                                class="development-banner-dismiss"
                                data-development-banner-dismiss
                                aria-label="Dismiss active development notice">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                </div>
            </header>

            <div class="shell-content @(isAuthenticated ? "app-content app-content-width" : "container")">
                <main role="main" class="pb-3">
                    @if (TempData["UiStatusMessage"] is string statusMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="status">
                            @statusMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted @(isAuthenticated ? "app-footer" : "public-footer")">
                <div class="@(isAuthenticated ? "app-content-width" : "container") d-flex flex-wrap justify-content-between gap-2">
                    <span>
                        &copy; 2026 · Comfy Capy Calories · A Comfy Capy product
                    </span>
                    <nav class="footer-links" aria-label="Footer">
                        <a asp-area="" asp-page="/About">About</a>
                        <a asp-area="" asp-page="/Help">Help</a>
                        <a asp-area="" asp-page="/Privacy">Privacy</a>
                        <a asp-area="" asp-page="/Feedback">Feedback</a>
                        <a href="https://ko-fi.com/comfycapy" target="_blank" rel="noopener noreferrer">Support Comfy Capy ❤️</a>
                    </nav>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/mobile-navigation.js" asp-append-version="true"></script>
    <script src="~/js/development-banner.js" asp-append-version="true"></script>

    <form id="themeAntiForgeryForm" method="post" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    <script>
            document.querySelectorAll(".theme-option").forEach(button => {
                button.addEventListener("click", async () => {
                    const selectedTheme = button.dataset.theme;

                    // Apply immediately to prevent a flash and persist the browser preference.
                    try { localStorage.setItem("theme", selectedTheme); } catch { }

                    let themeToApply = selectedTheme;

                    if (selectedTheme === "system") {
                        themeToApply =
                            window.matchMedia("(prefers-color-scheme: dark)").matches
                                ? "dark"
                                : "light";
                    }

                    document.documentElement.setAttribute(
                        "data-bs-theme",
                        themeToApply
                    );

                    document.documentElement.setAttribute(
                        "data-theme-preference",
                        selectedTheme
                    );

                    // Persist signed-in choices on the account so server-rendered pages keep the preference.
                    @if (User.Identity?.IsAuthenticated == true)
                        {
                            <text>
                                    const antiForgeryToken =
                                    document.querySelector(
                                    '#themeAntiForgeryForm input[name="__RequestVerificationToken"]'
                                    ).value;

                                    const themeForServer =
                                    selectedTheme.charAt(0).toUpperCase() +
                                    selectedTheme.slice(1);
                                    try {
                                        const response = await fetch('@Url.Page("/Profile/Index", "Theme")', {
                                            method: "POST",
                                            headers: {
                                                "Content-Type": "application/x-www-form-urlencoded",
                                                "X-CSRF-TOKEN": antiForgeryToken
                                            },
                                            body: new URLSearchParams({
                                                theme: themeForServer
                                            })
                                        });

                                        if (!response.ok) {
                                            console.error(
                                                "Theme preference save failed.",
                                                response.status,
                                                await response.text()
                                            );
                                        }
                                    }
                                    catch (error) {
                                        console.error(
                                            "Unable to save theme preference.",
                                            error
                                        );
                            }
                            </text>
                    }
                    });
            });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
