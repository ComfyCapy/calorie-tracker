@page
@model CalorieTracker.Pages.Profile.IndexModel
@using CalorieTracker.Services
@{
    ViewData["Title"] = "Profile & Goals";
}

@if (Model.IsFirstTimeSetup)
{
    <h1>Set up your profile</h1>

    <p class="text-muted">
        Tell us a little about yourself so we can estimate your daily calorie needs.
        You can change these settings at any time.
    </p>
}
else
{
    <h1>Profile & Goals</h1>

    <p class="text-muted">
        Update your details, goals and calorie target.
    </p>
}

@if (!string.IsNullOrWhiteSpace(Model.ProfileStatusMessage))
{
    <div class="alert alert-success">
        @Model.ProfileStatusMessage
    </div>
}

<form method="post" class="form-shell">

    <div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert"></div>

    <input asp-for="UserProfile.ThemePreference"
           type="hidden"
           id="profileThemePreference" />

    <fieldset class="form-section">
        <legend>Body details</legend>
    <div class="mb-3">
        <label asp-for="UserProfile.DateOfBirth" class="form-label">
            Date of Birth
        </label>

        <input asp-for="UserProfile.DateOfBirth"
               type="date"
               class="form-control"
               max="@DateTime.Today.ToString("yyyy-MM-dd")"
               data-msg-max="Date of birth cannot be in the future."
               aria-required="true" />

        <span asp-validation-for="UserProfile.DateOfBirth"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <fieldset class="border-0 p-0 m-0">
            <legend class="form-label">Measurement System</legend>

        <div>
            <div class="form-check form-check-inline">
                <input asp-for="UserProfile.MeasurementSystem"
                       class="form-check-input"
                       type="radio"
                       value="@ProfileOptions.Metric"
                       id="metricSystem" />

                <label class="form-check-label" for="metricSystem">
                    Metric
                </label>
            </div>

            <div class="form-check form-check-inline">
                <input asp-for="UserProfile.MeasurementSystem"
                       class="form-check-input"
                       type="radio"
                       value="@ProfileOptions.Imperial"
                       id="imperialSystem" />

                <label class="form-check-label" for="imperialSystem">
                    Imperial
                </label>
            </div>
        </div>
        </fieldset>
    </div>

    <div id="metricHeightSection" class="mb-3">
        <label asp-for="UserProfile.HeightCm" class="form-label">
            Height (cm)
        </label>

        <input asp-for="UserProfile.HeightCm"
               class="form-control" />

        <span asp-validation-for="UserProfile.HeightCm"
              class="text-danger"></span>
    </div>

    <div id="imperialHeightSection"
         class="mb-3"
         style="display: none;">

        <div class="form-label">Height</div>

        <div class="row g-2">
            <div class="col">
                <label for="HeightFeet" class="visually-hidden">Height in feet</label>
                <div class="input-group">
                    <input asp-for="HeightFeet"
                           class="form-control" />

                    <span class="input-group-text">ft</span>
                </div>

                <span asp-validation-for="HeightFeet"
                      class="text-danger"></span>
            </div>

            <div class="col">
                <label for="HeightInches" class="visually-hidden">Height in inches</label>
                <div class="input-group">
                    <input asp-for="HeightInches"
                           class="form-control"
                           step="0.01" />

                    <span class="input-group-text">in</span>
                </div>

                <span asp-validation-for="HeightInches"
                      class="text-danger"></span>
            </div>
        </div>
    </div>

    <div id="metricWeightSection" class="mb-3">
        <label asp-for="UserProfile.WeightKg" class="form-label">
            Current Weight (kg)
        </label>

        <input asp-for="UserProfile.WeightKg"
               class="form-control" />

        <span asp-validation-for="UserProfile.WeightKg"
              class="text-danger"></span>
    </div>

    <div id="imperialWeightSection"
         class="mb-3"
         style="display: none;">

        <label asp-for="WeightLb" class="form-label">
            Current Weight (lb)
        </label>

        <input asp-for="WeightLb"
               class="form-control"
               step="0.1" />

        <span asp-validation-for="WeightLb"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UserProfile.CalculationSex" class="form-label">
            Sex used for calorie calculation
        </label>

        <select asp-for="UserProfile.CalculationSex"
                class="form-select"
                aria-required="true">

            <option value="">Select...</option>
            <option value="@ProfileOptions.Male">Male</option>
            <option value="@ProfileOptions.Female">Female</option>
        </select>

        <div class="form-text">
            Used to estimate your BMR and daily calorie needs.
        </div>

        <span asp-validation-for="UserProfile.CalculationSex"
              class="text-danger"></span>
    </div>

    </fieldset>
    <fieldset class="form-section">
        <legend>Activity & goals</legend>
    <div class="mb-3">
        <label asp-for="UserProfile.ActivityLevel" class="form-label">
            Activity Level
        </label>

        <select asp-for="UserProfile.ActivityLevel"
                class="form-select"
                aria-required="true">

            <option value="">Select...</option>

            <option value="@ProfileOptions.Sedentary">
                Sedentary — little or no exercise
            </option>

            <option value="@ProfileOptions.LightlyActive">
                Lightly active — exercise 1–3 days/week
            </option>

            <option value="@ProfileOptions.ModeratelyActive">
                Moderately active — exercise 3–5 days/week
            </option>

            <option value="@ProfileOptions.VeryActive">
                Very active — hard exercise 6–7 days/week
            </option>

            <option value="@ProfileOptions.ExtraActive">
                Extra active — very hard exercise or physical job
            </option>
        </select>

        <div class="form-text">
            Choose the option that best reflects your typical week.
            This affects your estimated maintenance calories.
        </div>

        <span asp-validation-for="UserProfile.ActivityLevel"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UserProfile.Goal" class="form-label">
            Goal
        </label>

        <select asp-for="UserProfile.Goal"
                id="goalSelect"
                class="form-select"
                aria-required="true">

            <option value="">Select...</option>
            <option value="@ProfileOptions.Lose">Lose weight</option>
            <option value="@ProfileOptions.Maintain">Maintain weight</option>
            <option value="@ProfileOptions.Gain">Gain weight</option>
        </select>

        <span asp-validation-for="UserProfile.Goal"
              class="text-danger"></span>
    </div>

    <div id="metricGoalWeightSection"
         class="mb-3">

        <label asp-for="UserProfile.GoalWeightKg"
               class="form-label">
            Goal Weight (kg)
        </label>

        <input asp-for="UserProfile.GoalWeightKg"
               class="form-control"
               aria-describedby="metricGoalConsistencyError" />

        <div class="form-text">
            Used to track your progress towards your goal.
        </div>

        <span asp-validation-for="UserProfile.GoalWeightKg"
              class="text-danger"></span>

        <span id="metricGoalConsistencyError"
              class="text-danger"
              role="status"
              aria-live="polite"
              aria-atomic="true"></span>
    </div>

    <div id="imperialGoalWeightSection"
         class="mb-3"
         style="display: none;">

        <label asp-for="GoalWeightLb"
               class="form-label">
            Goal Weight (lb)
        </label>

        <input asp-for="GoalWeightLb"
               class="form-control"
               step="0.1"
               aria-describedby="imperialGoalConsistencyError" />

        <span asp-validation-for="GoalWeightLb"
              class="text-danger"></span>

        <span id="imperialGoalConsistencyError"
              class="text-danger"
              role="status"
              aria-live="polite"
              aria-atomic="true"></span>

        <div class="form-text">
            Used to track your progress towards your goal.
        </div>
    </div>

    <div id="weeklyGoalSection"
         class="mb-3">

        <label asp-for="UserProfile.WeeklyGoalKg"
               class="form-label">
            Weekly Weight Change
        </label>

        <select asp-for="UserProfile.WeeklyGoalKg"
                id="weeklyGoalSelect"
                class="form-select">

            <option value="">Select...</option>

            <option value="0.25"
                    data-metric="0.25 kg per week"
                    data-imperial="0.55 lb per week">
                0.25 kg per week
            </option>

            <option value="0.5"
                    data-metric="0.5 kg per week"
                    data-imperial="1.1 lb per week">
                0.5 kg per week
            </option>

            <option value="0.75"
                    data-metric="0.75 kg per week"
                    data-imperial="1.65 lb per week">
                0.75 kg per week
            </option>

            <option value="1.0"
                    data-metric="1.0 kg per week"
                    data-imperial="2.2 lb per week">
                1.0 kg per week
            </option>
        </select>

        <div class="form-text">
            Used to estimate your daily calorie target.
        </div>

        <span asp-validation-for="UserProfile.WeeklyGoalKg"
              class="text-danger"></span>
    </div>

    </fieldset>
    <fieldset class="form-section">
        <legend>Calorie target</legend>
    <div class="mb-3">
        <fieldset class="border-0 p-0 m-0">
            <legend class="form-label">Daily Calorie Target</legend>

        <div class="form-check">
            <input asp-for="UseCustomCalorieTarget"
                   class="form-check-input"
                   type="radio"
                   value="false"
                   id="calculatedTarget" />

            <label class="form-check-label"
                   for="calculatedTarget">
                Use calculated target
            </label>
        </div>

        <div class="form-text mb-2">
            Estimated from your age, height, weight,
            activity level and weight-change goal.
        </div>

        <div class="form-check">
            <input asp-for="UseCustomCalorieTarget"
                   class="form-check-input"
                   type="radio"
                   value="true"
                   id="customTarget" />

            <label class="form-check-label"
                   for="customTarget">
                Use custom target
            </label>
        </div>

        <div class="form-text">
            Choose this if you already know the daily
            calorie target you want to use.
        </div>
        </fieldset>
    </div>

    <div id="customCalorieTargetSection"
         class="mb-3">

        <label asp-for="UserProfile.CustomCalorieTarget"
               class="form-label">
            Custom Daily Calorie Target
        </label>

        <div class="input-group">
            <input asp-for="UserProfile.CustomCalorieTarget"
                   class="form-control" />

            <span class="input-group-text">
                kcal/day
            </span>
        </div>

        <span asp-validation-for="UserProfile.CustomCalorieTarget"
              class="text-danger"></span>
    </div>

    </fieldset>
    <button type="submit"
            class="btn btn-primary">
        Save Profile
    </button>
</form>


@if (Model.EstimatesProfile != null)
{
    <div class="card form-shell mt-4">
        <div class="card-body">

            <h2 class="card-title h3">
                Your Estimates
            </h2>

            <p class="text-muted">
                These estimates are based on the information in your profile.
            </p>

            <div class="border rounded p-3 mb-4">
                <small class="text-muted">
                    Daily Calorie Target
                </small>

                <h3 class="mb-1 h2">
                    @Model.EstimatesProfile.EffectiveCalorieTarget.ToString("0")
                    <small class="fs-6 fw-normal">kcal/day</small>
                </h3>

                @if (Model.EstimatesProfile.CustomCalorieTarget.HasValue)
                {
                    <p class="text-muted mb-0">
                        Your custom calorie target.
                    </p>
                }
                else if (Model.EstimatesProfile.Goal == ProfileOptions.Maintain)
                {
                    <p class="text-muted mb-0">
                        Calculated to maintain your current weight.
                    </p>
                }
                else if (Model.EstimatesProfile.Goal == ProfileOptions.Lose)
                {
                    <p class="text-muted mb-0">
                        Calculated for your selected rate of weight loss.
                    </p>
                }
                else if (Model.EstimatesProfile.Goal == ProfileOptions.Gain)
                {
                    <p class="text-muted mb-0">
                        Calculated for your selected rate of weight gain.
                    </p>
                }
            </div>

            <div class="row g-3">

                <div class="col-md-3">
                    <strong>Maintenance Calories</strong>

                    <p class="mb-1">
                        ~@Model.EstimatesProfile.TDEE.ToString("0") kcal/day
                    </p>

                    <small class="text-muted">
                        Estimated calories needed to maintain your current weight.
                    </small>
                </div>

                <div class="col-md-3">
                    <strong>BMR</strong>

                    <p class="mb-1">
                        ~@Model.EstimatesProfile.BMR.ToString("0") kcal/day
                    </p>

                    <small class="text-muted">
                        Estimated calories your body uses at rest.
                    </small>
                </div>

                <div class="col-md-3">
                    <strong>BMI</strong>

                    <p class="mb-1">
                        @Model.EstimatesProfile.BMI.ToString("0.0")
                    </p>

                    <small class="text-muted">
                        Calculated from your current height and weight.
                    </small>
                </div>

                <div class="col-md-3">
                    <strong>Age</strong>

                    <p class="mb-1">
                        @Model.EstimatesProfile.Age years
                    </p>

                    <small class="text-muted">
                        Used as part of your calorie estimate.
                    </small>
                </div>

            </div>

            <hr class="my-4" />

            <small class="text-muted">
                Calorie needs vary between individuals and these figures are estimates,
                not exact measurements. Your actual needs may change over time.
            </small>

        </div>
    </div>
}


@section Scripts {

    <script src="~/js/profile.js" asp-append-version="true"></script>

    <partial name="_ValidationScriptsPartial" />
}
