@page
@model CalorieTracker.Pages.Foods.IndexModel
@{
    ViewData["Title"] = "My Foods";
}

<link rel="stylesheet"
      href="~/react-food-search/assets/food-search.css"
      asp-append-version="true" />

<h1>My Foods</h1>

<form method="get" class="mb-3">
    <input type="hidden"
           asp-for="ReturnToDiary" />

    <input type="hidden"
           asp-for="DiaryDate" />

    <input type="hidden"
           asp-for="DiaryMeal" />

    <div class="input-group">
        <label for="foodSearchTerm" class="visually-hidden">Search my foods</label>
        <input type="text"
               id="foodSearchTerm"
               name="searchTerm"
               value="@Model.SearchTerm"
               class="form-control"
               placeholder="Search my foods..." />

        <button type="submit"
                class="btn btn-outline-primary">
            Search
        </button>
    </div>
</form>

<p>
    <a asp-page="./Create"
       asp-route-returnToDiary="@Model.ReturnToDiary"
       asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
       asp-route-diaryMeal="@Model.DiaryMeal"
       class="btn btn-primary">
        Add Custom Food
    </a>
</p>

@if (string.IsNullOrWhiteSpace(Model.SearchTerm) && Model.FavouriteFoods.Count == 0
    && Model.CustomFoods.Count == 0 && Model.RecentFoods.Count == 0)
{
    <div class="card my-4">
        <div class="card-body">
            <h2 class="h5">Start your food collection</h2>
            <p class="mb-0 text-body-secondary">Search the USDA database above or add a custom food. Favourite foods you use often to find them here next time.</p>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
{
    <p>
        Showing results for
        "<strong>@Model.SearchTerm</strong>"

        <a asp-page="./Index"
           asp-route-returnToDiary="@Model.ReturnToDiary"
           asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
           asp-route-diaryMeal="@Model.DiaryMeal">
            Clear Search
        </a>
    </p>
}


@* =========================
   FAVOURITES
   ========================= *@

@if (Model.FavouriteFoods.Count > 0)
{
    <section class="mt-4">
        <h2>Favourites</h2>

        <div class="food-search-list">
            @foreach (var food in Model.FavouriteFoods)
            {
                <article class="food-search-result">
                    <div class="food-search-result-main">
                        <div>
                            <h3>@food.Name</h3>

                            <p>
                                Per @food.ServingSize.ToString("0.##")@food.ServingUnit
                            </p>
                        </div>

                        <strong class="food-search-calories">
                            @food.Calories kcal
                        </strong>
                    </div>

                    <div class="food-search-result-bottom">
                        <div class="food-search-macros">
                            <span>
                                <strong aria-hidden="true">P</strong>
                                <span class="visually-hidden">Protein </span>
                                @food.Protein.ToString("0.##")g
                            </span>

                            <span>
                                <strong aria-hidden="true">C</strong>
                                <span class="visually-hidden">Carbohydrates </span>
                                @food.Carbohydrates.ToString("0.##")g
                            </span>

                            <span>
                                <strong aria-hidden="true">F</strong>
                                <span class="visually-hidden">Fat </span>
                                @food.Fat.ToString("0.##")g
                            </span>
                        </div>

                        <div class="food-search-actions">
                            <form method="post"
                                  asp-page-handler="Unfavourite"
                                  asp-route-id="@food.Id"
                                  asp-route-searchTerm="@Model.SearchTerm"
                                  asp-route-returnToDiary="@Model.ReturnToDiary"
                                  asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
                                  asp-route-diaryMeal="@Model.DiaryMeal">

                                <button type="submit"
                                        class="food-search-favourite-button is-favourite"
                                        aria-label="Remove @food.Name from Favourites"
                                        title="Remove @food.Name from Favourites">
                                    ★
                                </button>
                            </form>

                            @if (food.Source != null)
                            {
                                <a asp-page="./ApiFood"
                                   asp-route-id="@food.ExternalId"
                                   asp-route-date="@(Model.ReturnToDiary ? Model.DiaryDate?.ToString("yyyy-MM-dd") : null)"
                                   asp-route-meal="@(Model.ReturnToDiary ? Model.DiaryMeal : null)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   class="btn btn-primary btn-sm">
                                    Add to Diary
                                </a>
                            }
                            else
                            {
                                <a asp-page="../Diary/Create"
                                   asp-route-foodId="@food.Id"
                                   asp-route-date="@(Model.ReturnToDiary ? Model.DiaryDate?.ToString("yyyy-MM-dd") : null)"
                                   asp-route-meal="@(Model.ReturnToDiary ? Model.DiaryMeal : null)"
                                   class="btn btn-primary btn-sm">
                                    Add to Diary
                                </a>

                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary food-actions-button"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Actions for @food.Name">
                                        ⋮
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a asp-page="./Edit"
                                               asp-route-id="@food.Id"
                                               class="dropdown-item">
                                                Edit
                                            </a>
                                        </li>

                                        <li>
                                            <a asp-page="./Portions"
                                               asp-route-id="@food.Id"
                                               class="dropdown-item">
                                                Manage portions
                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a asp-page="./Delete"
                                               asp-route-id="@food.Id"
                                               class="dropdown-item text-danger">
                                                Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-muted">
                Showing
                @(((Model.FavouritesPage - 1) * Model.PageSize) + 1)
                –
                @Math.Min(
                    Model.FavouritesPage * Model.PageSize,
                    Model.FavouritesTotalCount)
                of @Model.FavouritesTotalCount
            </small>

            @if (Model.FavouritesTotalPages > 1)
            {
                <nav aria-label="Favourites pages">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.FavouritesPage <= 1 ? "disabled" : "")">
                            @if (Model.FavouritesPage <= 1)
                            {
                                <span class="page-link" aria-disabled="true">‹</span>
                            }
                            else
                            {
                                <a class="page-link"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-returnToDiary="@Model.ReturnToDiary"
                                   asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
                                   asp-route-diaryMeal="@Model.DiaryMeal"
                                   asp-route-favouritesPage="@(Model.FavouritesPage - 1)"
                                   asp-route-customPage="@Model.CustomPage"
                                   asp-route-recentPage="@Model.RecentPage"
                                   aria-label="Previous favourites page">
                                    ‹
                                </a>
                            }
                        </li>

                        <li class="page-item disabled">
                            <span class="page-link" aria-current="page">
                                Page @Model.FavouritesPage of @Model.FavouritesTotalPages
                            </span>
                        </li>

                        <li class="page-item @(Model.FavouritesPage >= Model.FavouritesTotalPages ? "disabled" : "")">
                            @if (Model.FavouritesPage >= Model.FavouritesTotalPages)
                            {
                                <span class="page-link" aria-disabled="true">›</span>
                            }
                            else
                            {
                                <a class="page-link"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-returnToDiary="@Model.ReturnToDiary"
                                   asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
                                   asp-route-diaryMeal="@Model.DiaryMeal"
                                   asp-route-favouritesPage="@(Model.FavouritesPage + 1)"
                                   asp-route-customPage="@Model.CustomPage"
                                   asp-route-recentPage="@Model.RecentPage"
                                   aria-label="Next favourites page">
                                    ›
                                </a>
                            }
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </section>
}


@* =========================
   CUSTOM FOODS
   ========================= *@

