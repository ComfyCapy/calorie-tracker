@page
@model CalorieTracker.Pages.Foods.IndexModel
<h1>Foods</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Add Food</a>
</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchTerm"
               value="@Model.SearchTerm"
               class="form-control"
               placeholder="Search foods..." />
        <button type="submit" class="btn btn-outline-primary">Search</button>
     </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
{
    
<p>
    Showing results for "<strong>@Model.SearchTerm</strong>"
    <a asp-page="./Index">Clear Search</a></p> }

@if (Model.Foods.Count == 0)
{
    <p>No foods available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Calories</th>
                <th>Protein</th>
                <th>Carbs</th>
                <th>Fat</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var food in Model.Foods)
            {
                <tr>
                    <td>@food.Name</td>
                    <td>@food.Calories kcal 
                        <small class="text-muted">
                            per @food.ServingSize.ToString("0.##") @food.ServingUnit
                        </small>
                    </td>
                    <td>@food.Protein g</td>
                    <td>@food.Carbohydrates g</td>
                    <td>@food.Fat g</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-page="./Edit"
                               asp-route-id="@food.Id"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <a asp-page="./Portions"
                               asp-route-id="@food.Id"
                               class="btn btn-sm btn-primary">
                                Portions
                            </a>

                            <a asp-page="./Delete"
                               asp-route-id="@food.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
