        <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-muted">
                Showing
                @(((Model.CustomPage - 1) * Model.PageSize) + 1)
                –
                @Math.Min(
                    Model.CustomPage * Model.PageSize,
                    Model.CustomTotalCount)
                of @Model.CustomTotalCount
            </small>

            @if (Model.CustomTotalPages > 1)
            {
                <nav aria-label="Custom food pages">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CustomPage <= 1 ? "disabled" : "")">
                            @if (Model.CustomPage <= 1)
                            {
                                <span class="page-link" aria-disabled="true">‹</span>
                            }
                            else
                            {
                                <a class="page-link"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-returnToDiary="@Model.ReturnToDiary"
                                   asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
                                   asp-route-diaryMeal="@Model.DiaryMeal"
                                   asp-route-favouritesPage="@Model.FavouritesPage"
                                   asp-route-customPage="@(Model.CustomPage - 1)"
                                   asp-route-recentPage="@Model.RecentPage"
                                   aria-label="Previous custom food page">
                                    ‹
                                </a>
                            }
                        </li>

                        <li class="page-item disabled">
                            <span class="page-link" aria-current="page">
                                Page @Model.CustomPage of @Model.CustomTotalPages
                            </span>
                        </li>

                        <li class="page-item @(Model.CustomPage >= Model.CustomTotalPages ? "disabled" : "")">
                            @if (Model.CustomPage >= Model.CustomTotalPages)
                            {
                                <span class="page-link" aria-disabled="true">›</span>
                            }
                            else
                            {
                                <a class="page-link"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-returnToDiary="@Model.ReturnToDiary"
                                   asp-route-diaryDate="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
                                   asp-route-diaryMeal="@Model.DiaryMeal"
                                   asp-route-favouritesPage="@Model.FavouritesPage"
                                   asp-route-customPage="@(Model.CustomPage + 1)"
                                   asp-route-recentPage="@Model.RecentPage"
                                   aria-label="Next custom food page">
                                    ›
                                </a>
                            }
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </section>
}


