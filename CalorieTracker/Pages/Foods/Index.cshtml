@page
@model CalorieTracker.Pages.Foods.IndexModel

<h1>My Foods</h1>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchTerm"
               value="@Model.SearchTerm"
               class="form-control"
               placeholder="Search my foods..." />

        <button type="submit"
                class="btn btn-outline-primary">
            Search
        </button>
    </div>
</form>

<p>
    <a asp-page="./Create"
       class="btn btn-primary">
        Add Custom Food
    </a>
</p>

@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
{
    <p>
        Showing results for
        "<strong>@Model.SearchTerm</strong>"

        <a asp-page="./Index">
            Clear Search
        </a>
    </p>

    @if (Model.FavouriteFoods.Count == 0 &&
         Model.CustomFoods.Count == 0 &&
         Model.RecentFoods.Count == 0)
    {
        <div class="alert alert-secondary">
            No foods found matching
            "<strong>@Model.SearchTerm</strong>".
        </div>
    }
}


@* =========================
   FAVOURITES
   ========================= *@

@if (Model.FavouriteFoods.Count > 0)
{
    <h2 class="mt-4">Favourites</h2>

    <table class="table food-table" style="table-layout: fixed;">
        <colgroup>
            <col style="width: 32%;">
            <col style="width: 20%;">
            <col style="width: 12%;">
            <col style="width: 10%;">
            <col style="width: 10%;">
            <col style="width: 16%;">
        </colgroup>

        <thead>
            <tr>
                <th>Name</th>
                <th>Calories</th>
                <th>Protein</th>
                <th>Carbs</th>
                <th>Fat</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var food in Model.FavouriteFoods)
            {
                <tr>
                    <td>@food.Name</td>

                    <td>
                        @food.Calories kcal

                        <small class="text-muted">
                            per @food.ServingSize.ToString("0.##")
                            @food.ServingUnit
                        </small>
                    </td>

                    <td>
                        @food.Protein.ToString("0.##") g
                    </td>

                    <td>
                        @food.Carbohydrates.ToString("0.##") g
                    </td>

                    <td>
                        @food.Fat.ToString("0.##") g
                    </td>

                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary food-actions-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Food actions">
                                ⋮
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (food.Source != null)
                                {
                                    <li>
                                        <a asp-page="./ApiFood"
                                           asp-route-id="@food.ExternalId"
                                           class="dropdown-item">
                                            Add to Diary
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a asp-page="../Diary/Create"
                                           asp-route-foodId="@food.Id"
                                           class="dropdown-item">
                                            Add to Diary
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="./Edit"
                                           asp-route-id="@food.Id"
                                           class="dropdown-item">
                                            Edit
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="./Portions"
                                           asp-route-id="@food.Id"
                                           class="dropdown-item">
                                            Manage portions
                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <form method="post"
                                          asp-page-handler="Unfavourite"
                                          asp-route-id="@food.Id">
                                        <button type="submit"
                                                class="dropdown-item text-danger">
                                            Remove from Favourites
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">
            Showing
            @(((Model.FavouritesPage - 1) * Model.PageSize) + 1)
            –
            @Math.Min(
                Model.FavouritesPage * Model.PageSize,
                Model.FavouritesTotalCount)
            of @Model.FavouritesTotalCount
        </small>

        @if (Model.FavouritesTotalPages > 1)
        {
            <nav aria-label="Favourites pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.FavouritesPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-favouritesPage="@(Model.FavouritesPage - 1)"
                           asp-route-customPage="@Model.CustomPage"
                           asp-route-recentPage="@Model.RecentPage">
                            ‹
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            Page @Model.FavouritesPage of @Model.FavouritesTotalPages
                        </span>
                    </li>

                    <li class="page-item @(Model.FavouritesPage >= Model.FavouritesTotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-favouritesPage="@(Model.FavouritesPage + 1)"
                           asp-route-customPage="@Model.CustomPage"
                           asp-route-recentPage="@Model.RecentPage">
                            ›
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}


