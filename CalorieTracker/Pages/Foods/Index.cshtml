@* =========================
   FOOD DATABASE
   ========================= *@

@if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
{
    <div id="react-food-search"
         data-return-to-diary="@Model.ReturnToDiary.ToString().ToLowerInvariant()"
         data-diary-date="@Model.DiaryDate?.ToString("yyyy-MM-dd")"
         data-diary-meal="@Model.DiaryMeal"
         data-initial-search-term="@Model.SearchTerm"
         data-embedded="true">
    </div>
}

@section Scripts {
    <script type="module"
            src="~/react-food-search/assets/food-search.js"
            asp-append-version="true"></script>
}
