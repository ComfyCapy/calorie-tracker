        <colgroup>
            <col style="width: 32%;">
            <col style="width: 20%;">
            <col style="width: 12%;">
            <col style="width: 10%;">
            <col style="width: 10%;">
            <col style="width: 16%;">
        </colgroup>

        <thead>
            <tr>
                <th>Name</th>
                <th>Calories</th>
                <th>Protein</th>
                <th>Carbs</th>
                <th>Fat</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var food in Model.RecentFoods)
            {
                <tr>
                    <td>@food.Name</td>

                    <td>
                        @food.Calories kcal

                        <small class="text-muted">
                            per @food.ServingSize.ToString("0.##")
                            @food.ServingUnit
                        </small>
                    </td>

                    <td>
                        @food.Protein.ToString("0.##") g
                    </td>

                    <td>
                        @food.Carbohydrates.ToString("0.##") g
                    </td>

                    <td>
                        @food.Fat.ToString("0.##") g
                    </td>

                    <td>
                        <a asp-page="./ApiFood"
                           asp-route-id="@food.ExternalId"
                           class="btn btn-sm btn-primary">
