                        <small class="text-muted">
                            per @food.ServingSize.ToString("0.##")
                            @food.ServingUnit
                        </small>
                    </td>

                    <td>
                        @food.Protein.ToString("0.##") g
                    </td>

                    <td>
                        @food.Carbohydrates.ToString("0.##") g
                    </td>

                    <td>
                        @food.Fat.ToString("0.##") g
                    </td>

                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary food-actions-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Food actions">
                                ⋮
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a asp-page="./Edit"
                                       asp-route-id="@food.Id"
                                       class="dropdown-item">
                                        Edit
                                    </a>
                                </li>

                                <li>
                                    <a asp-page="./Portions"
                                       asp-route-id="@food.Id"
                                       class="dropdown-item">
                                        Manage portions
                                    </a>
                                </li>

                                @if (!food.IsFavourite)
                                {
                                    <li>
                                        <form method="post"
                                              asp-page-handler="Favourite"
                                              asp-route-id="@food.Id">
                                            <button type="submit"
