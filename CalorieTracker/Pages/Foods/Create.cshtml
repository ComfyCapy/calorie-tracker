@page
@model CalorieTracker.Pages.Foods.CreateModel
@{
    ViewData["Title"] = "Add Food";
}

<h1>Add Food</h1>

<form method="post" class="form-shell">
    <div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert"></div>
    <input type="hidden" asp-for="ReturnToDiary" />
    <input type="hidden" asp-for="DiaryDate" />
    <input type="hidden" asp-for="DiaryMeal" />

    <fieldset class="form-section">
        <legend>Food details</legend>
    <div class="mb-3">
        <label asp-for="Food.Name" class="form-label"></label>
        <input asp-for="Food.Name" class="form-control" />
        <span asp-validation-for="Food.Name" class="text-danger"></span>
    </div>

    </fieldset>
    <fieldset class="form-section">
        <legend>Nutrition per serving</legend>
        <p class="form-text">Enter calories in kcal and protein, carbohydrates and fat in grams for the serving below.</p>
    <div class="mb-3">
        <label asp-for="Food.Calories" class="form-label"></label>
        <input asp-for="Food.Calories" class="form-control" />
        <span asp-validation-for="Food.Calories" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Food.Protein" class="form-label"></label>
        <input asp-for="Food.Protein" class="form-control" />
        <span asp-validation-for="Food.Protein" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Food.Carbohydrates" class="form-label"></label>
        <input asp-for="Food.Carbohydrates" class="form-control" />
        <span asp-validation-for="Food.Carbohydrates" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Food.Fat" class="form-label"></label>
        <input asp-for="Food.Fat" class="form-control" />
        <span asp-validation-for="Food.Fat" class="text-danger"></span>
    </div>

    </fieldset>
    <fieldset class="form-section">
        <legend>Serving basis</legend>
    <div class="mb-3">
        <label asp-for="Food.ServingSize" class="form-label"></label>
        <input asp-for="Food.ServingSize" class="form-control" />
        <span asp-validation-for="Food.ServingSize" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Food.ServingUnit" class="form-label"></label>

        <select asp-for="Food.ServingUnit" class="form-select">
            <option value="g">g</option>
            <option value="kg">kg</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="ml">ml</option>
            <option value="L">L</option>
            <option value="fl oz">fl oz</option>
        </select>

        <span asp-validation-for="Food.ServingUnit" class="text-danger"></span>
    </div>

    </fieldset>
    <input type="hidden"
           asp-for="AddToFavourites"
           id="addToFavouritesInput" />

    <div class="mb-3 mt-3 d-flex gap-2 align-items-center">
        <button type="button"
                id="favouriteToggle"
                class="btn btn-outline-warning"
                aria-label="Add to Favourites"
                title="Add to Favourites">
            ☆
        </button>

        <button type="submit"
                class="btn btn-primary">
            Add Food
        </button>

        <a asp-page="@(Model.ReturnToDiary ? "/Diary/Create" : "./Index")"
           asp-route-date="@(Model.ReturnToDiary ? Model.DiaryDate?.ToString("yyyy-MM-dd") : null)"
           asp-route-meal="@(Model.ReturnToDiary ? Model.DiaryMeal : null)"
           class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const favouriteInput =
            document.getElementById("addToFavouritesInput");

        const favouriteToggle =
            document.getElementById("favouriteToggle");

        function updateFavouriteButton() {
            const isFavourite =
                favouriteInput.value.toLowerCase() === "true";

            favouriteToggle.textContent =
                isFavourite ? "★" : "☆";

            favouriteToggle.classList.toggle(
                "btn-warning",
                isFavourite);

            favouriteToggle.classList.toggle(
                "btn-outline-warning",
                !isFavourite);

            favouriteToggle.setAttribute(
                "aria-label",
                isFavourite
                    ? "Remove from Favourites"
                    : "Add to Favourites");

            favouriteToggle.setAttribute(
                "title",
                isFavourite
                    ? "Remove from Favourites"
                    : "Add to Favourites");
        }

        favouriteToggle.addEventListener(
            "click",
            function() {
                const isFavourite =
                    favouriteInput.value.toLowerCase() === "true";

                favouriteInput.value =
                    (!isFavourite).toString();

                updateFavouriteButton();
            });

        updateFavouriteButton();
    </script>
}
