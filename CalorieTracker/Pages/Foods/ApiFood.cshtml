@page
@model CalorieTracker.Pages.Foods.ApiFoodModel

@{
    ViewData["Title"] = Model.Food?.Name ?? "Food";
}

@if (Model.Food != null)
{
    <div class="form-shell">
    <h1>@Model.Food.Name</h1>

    <p class="text-muted">
        Nutrition per 100 g
    </p>

    <dl class="row">
        <dt class="col-sm-3">Calories</dt>
        <dd class="col-sm-9">
            @Model.Food.Calories.ToString("0.#") kcal
        </dd>

        <dt class="col-sm-3">Protein</dt>
        <dd class="col-sm-9">
            @Model.Food.Protein.ToString("0.##") g
        </dd>

        <dt class="col-sm-3">Carbs</dt>
        <dd class="col-sm-9">
            @Model.Food.Carbohydrates.ToString("0.##") g
        </dd>

        <dt class="col-sm-3">Fat</dt>
        <dd class="col-sm-9">
            @Model.Food.Fat.ToString("0.##") g
        </dd>
    </dl>

    <hr />

    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert"></div>
        <input type="hidden"
               asp-for="ExternalId" />

        <input type="hidden"
               asp-for="SearchTerm" />

        <div class="mb-3">
            <label asp-for="Quantity"
                   class="form-label">
                Amount (g)
            </label>

            <input asp-for="Quantity"
                   class="form-control"
                   step="0.01"
                   min="0.01" />

            <span asp-validation-for="Quantity"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="MealType"
                   class="form-label">
                Meal
            </label>

            <select asp-for="MealType"
                    class="form-select">
                <option value="Breakfast">Breakfast</option>
                <option value="Lunch">Lunch</option>
                <option value="Dinner">Dinner</option>
                <option value="Snack">Snack</option>
            </select>

            <span asp-validation-for="MealType"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Date"
                   class="form-label">
                Date
            </label>

            <input asp-for="Date"
                   type="date"
                   min="1900-01-01"
                   max="2100-12-31"
                   class="form-control" />

            <span asp-validation-for="Date"
                  class="text-danger">
            </span>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            @if (Model.IsFavourite)
            {
                <button type="submit"
                        asp-page-handler="Unfavourite"
                        formnovalidate
                        class="btn btn-warning"
                        aria-label="Remove @Model.Food.Name from Favourites"
                        title="Remove @Model.Food.Name from Favourites">
                    ★
                </button>
            }
            else
            {
                <button type="submit"
                        asp-page-handler="Favourite"
                        formnovalidate
                        class="btn btn-outline-warning"
                        aria-label="Add @Model.Food.Name to Favourites"
                        title="Add @Model.Food.Name to Favourites">
                    ☆
                </button>
            }

            <button type="submit"
                    class="btn btn-primary"
                    aria-label="Add @Model.Food.Name to Diary">
                Add to Diary
            </button>

            <a asp-page="./Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-returnToDiary="true"
               asp-route-diaryDate="@Model.Date.ToString("yyyy-MM-dd")"
               asp-route-diaryMeal="@Model.MealType"
               class="btn btn-secondary">
                Back to Search
            </a>
        </div>
    </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
