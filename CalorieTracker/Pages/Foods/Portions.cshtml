@page
@model CalorieTracker.Pages.Foods.PortionsModel
@{
    ViewData["Title"] = "Food Portions";
}

<h1>Portions for @Model.Food.Name</h1>

<p class="text-muted">
    Base serving: @Model.Food.ServingSize @Model.Food.ServingUnit
</p>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@Model.StatusMessage</strong>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert"></div>

@if (Model.Portions.Count == 0)
{
    <p>No portions have been added for this food yet.</p>
}
else
{
    @foreach (var portion in Model.Portions)
    {
        <form id="portion-@portion.Id" method="post" asp-page-handler="Edit"
              asp-route-id="@Model.Food.Id" asp-route-portionId="@portion.Id"></form>
    }
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Portion</th>
                <th scope="col">Amount</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var portion in Model.Portions)
            {
                <tr>


                        <td>
                            <label for="portion-name-@portion.Id" class="visually-hidden">
                                Portion name for @portion.Name
                            </label>
                            <input type="text"
                                   id="portion-name-@portion.Id"
                                   name="name"
                                   form="portion-@portion.Id"
                                   value="@(Model.EditedPortionId == portion.Id ? Model.EditedName : portion.Name)"
                                   class="form-control form-control-sm" />
                        </td>

                        <td>
                            <label for="portion-amount-@portion.Id" class="visually-hidden">
                                Amount in @Model.Food.ServingUnit for @portion.Name
                            </label>
                            <input type="number"
                                   id="portion-amount-@portion.Id"
                                   name="amount"
                                   form="portion-@portion.Id"
                                   value="@(Model.EditedPortionId == portion.Id ? Model.EditedAmount : CalorieTracker.Services.MeasurementUnits.FromCanonical(portion.Amount, Model.Food.ServingUnit).ToString("0.############################"))"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control form-control-sm" />
                        </td>

                        <td>
                            <div class="d-flex gap-1">
                                <button type="submit"
                                        form="portion-@portion.Id"
                                        class="btn btn-sm btn-primary">
                                    Save
                                </button>

                                <button type="submit"
                                        form="portion-@portion.Id"
                                        formnovalidate
                                        onclick="return confirm('Delete this portion? Existing diary entries will be kept.');"
                                        formaction="?handler=Delete&id=@Model.Food.Id&portionId=@portion.Id"
                                        class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </div>
                        </td>

                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h2>Add Portion</h2>

<form method="post" class="form-shell">
    <div class="mb-3">
        <label asp-for="NewPortion.Name" class="form-label">Portion Name</label>
        <input asp-for="NewPortion.Name"
               class="form-control"
               placeholder="e.g. Medium banana" />
        <span asp-validation-for="NewPortion.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewPortion.Amount" class="form-label">
            Amount (@Model.Food.ServingUnit)
        </label>
        <input asp-for="NewPortion.Amount"
               class="form-control"
               step="0.01" />
        <span asp-validation-for="NewPortion.Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add Portion</button>
</form>

<a asp-page="./Index" class="btn btn-secondary mt-3">Back to Foods</a>
