@page
@model CalorieTracker.Pages.Foods.EditModel
@{
    ViewData["Title"] = "Edit Food";
}

<h1>Edit Food</h1>

<form method="post" class="form-shell">
    <div asp-validation-summary="All" class="alert alert-danger validation-summary" role="alert"></div>
    <input type="hidden" name="id" value="@Model.Food.Id" />
    <fieldset class="form-section">
        <legend>Food details</legend>
    <div class="mb-3">
        <label asp-for="Food.Name" class="form-label"></label>
        <input asp-for="Food.Name" class="form-control" aria-required="true" />
        <span asp-validation-for="Food.Name" class="text-danger"></span>
    </div>
    </fieldset>
    <fieldset class="form-section">
        <legend>Nutrition per serving</legend>
        <p class="form-text">Enter calories in kcal and protein, carbohydrates and fat in grams for the serving below.</p>
    <div class="mb-3">
        <label asp-for="Food.Calories" class="form-label"></label>
        <input asp-for="Food.Calories" class="form-control" />
        <span asp-validation-for="Food.Calories" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Food.Protein" class="form-label"></label>
        <input asp-for="Food.Protein" class="form-control" />
        <span asp-validation-for="Food.Protein" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Food.Carbohydrates" class="form-label"></label>
        <input asp-for="Food.Carbohydrates" class="form-control" />
        <span asp-validation-for="Food.Carbohydrates" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Food.Fat" class="form-label"></label>
        <input asp-for="Food.Fat" class="form-control" />
        <span asp-validation-for="Food.Fat" class="text-danger"></span>
    </div>
    </fieldset>
    <fieldset class="form-section" data-serving-basis-form>
        <legend>Serving basis</legend>
        <p class="form-text">
            Choose whether the nutrition above is for a measured amount or a named portion.
        </p>

    <div class="mb-3">
        <div class="form-check form-check-inline">
            <input asp-for="Food.ServingBasis"
                   class="form-check-input"
                   type="radio"
                   value="Measured"
                   id="measuredServingBasis"
                   aria-controls="measuredServingFields portionServingFields" />
            <label class="form-check-label" for="measuredServingBasis">
                Weight / volume
            </label>
        </div>

        <div class="form-check form-check-inline">
            <input asp-for="Food.ServingBasis"
                   class="form-check-input"
                   type="radio"
                   value="Portion"
                   id="portionServingBasis"
                   aria-controls="measuredServingFields portionServingFields" />
            <label class="form-check-label" for="portionServingBasis">
                Portion
            </label>
        </div>

        <span asp-validation-for="Food.ServingBasis" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Food.ServingSize" class="form-label"></label>
        <input asp-for="Food.ServingSize"
               class="form-control"
               min="0.01"
               step="0.01" />
        <span asp-validation-for="Food.ServingSize" class="text-danger"></span>
    </div>

    <div id="measuredServingFields"
         class="mb-3"
         hidden="@(Model.Food.ServingBasis == CalorieTracker.Models.FoodServingBasis.Portion)">
        <label asp-for="Food.ServingUnit" class="form-label"></label>

        <select asp-for="Food.ServingUnit" class="form-select">
            <option value="g">g</option>
            <option value="kg">kg</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="ml">ml</option>
            <option value="L">L</option>
            <option value="fl oz">fl oz</option>
        </select>

        <span asp-validation-for="Food.ServingUnit" class="text-danger"></span>
    </div>

    <div id="portionServingFields"
         class="mb-3"
         hidden="@(Model.Food.ServingBasis != CalorieTracker.Models.FoodServingBasis.Portion)">
        <label asp-for="Food.PortionLabel" class="form-label"></label>
        <input asp-for="Food.PortionLabel"
               class="form-control"
               maxlength="@CalorieTracker.Models.Food.MaxPortionLabelLength"
               placeholder="e.g. sandwich" />
        <span asp-validation-for="Food.PortionLabel" class="text-danger"></span>
        <div class="form-text">
            No weight is required. The nutrition above applies directly to this portion.
        </div>
    </div>
    </fieldset>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/food-serving-basis.js" asp-append-version="true"></script>
}
