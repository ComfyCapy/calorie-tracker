@page
@model CalorieTracker.Pages.Diary.IndexModel

<h1>Daily Diary</h1>
<div class="d-flex align-items-center gap-3 mb-3">
    <a asp-page="./Index"
       asp-route-date="@Model.PreviousDate.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        ← Previous
    </a>

    <strong>
        @Model.SelectedDate.ToString("dddd, d MMMM yyyy")
    </strong>

    <a asp-page="./Index"
       class="btn btn-outline-primary">
        Today
    </a>

    <a asp-page="./Index"
       asp-route-date="@Model.NextDate.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        Next →
    </a>

    <form method="get" class="d-flex align-items-center gap-2">
        <input type="date"
               name="date"
               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
               class="form-control" />

        <button type="submit" class="btn btn-outline-primary">
            Go
        </button>
    </form>
</div>
<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">Daily Progress</h4>

        @if (Model.DailyCalorieTarget > 0)
        {
            <div class="d-flex justify-content-between align-items-end mb-2">
                <div>
                    <span class="fs-3 fw-bold">
                        @Model.TotalCalories.ToString("0")
                    </span>

                    <span class="text-muted">
                        / @Model.DailyCalorieTarget.ToString("0") kcal
                    </span>
                </div>

                <div class="text-end">
                    @if (Model.CaloriesRemaining >= 0)
                    {
                        <strong>
                            @Model.CaloriesRemaining.ToString("0") kcal remaining
                        </strong>
                    }
                    else
                    {
                        <strong>
                            @Math.Abs(Model.CaloriesRemaining).ToString("0") kcal over
                        </strong>
                    }
                </div>
            </div>

            <div class="progress mb-3" style="height: 20px;">
                <div class="progress-bar"
                     role="progressbar"
                     style="width: @Model.CalorieProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                     aria-valuenow="@Model.CalorieProgressPercent"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @Model.CalorieProgressPercent.ToString("0")%
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">
                Set up your profile and goals to see your daily calorie target.
            </p>
        }

        <div>
            <strong>@Model.TotalProtein.ToString("0.0") g</strong> protein
            <span class="mx-2">·</span>

            <strong>@Model.TotalCarbohydrates.ToString("0.0") g</strong> carbs
            <span class="mx-2">·</span>

            <strong>@Model.TotalFat.ToString("0.0") g</strong> fat
        </div>
    </div>
</div>

@foreach (var meal in new[] { "Breakfast", "Lunch", "Dinner", "Snack" })
{
    var mealEntries = Model.Entries
        .Where(entry => entry.MealType == meal)
        .ToList();

    var mealCalories = mealEntries.Sum(entry => entry.CaloriesConsumed);
    var mealProtein = mealEntries.Sum(entry => entry.ProteinConsumed);
    var mealCarbs = mealEntries.Sum(entry => entry.CarbohydratesConsumed);
    var mealFat = mealEntries.Sum(entry => entry.FatConsumed);

    <div class="mb-4">
        <div class="mb-3">
            <h3 class="mb-0">@meal</h3>

            @if (mealEntries.Count > 0)
            {
                <small class="text-muted d-block mb-2">
                    @mealCalories.ToString("0") kcal ·
                    @mealProtein.ToString("0.0")g protein ·
                    @mealCarbs.ToString("0.0")g carbs ·
                    @mealFat.ToString("0.0")g fat
                </small>
            }

            <a asp-page="./Create"
               asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")"
               asp-route-meal="@meal"
               class="btn btn-sm btn-outline-primary">
                + Add Food
            </a>
        </div>

        @if (mealEntries.Count == 0)
        {
            <p class="text-muted">No entries.</p>
        }
        else
        {
            <table class="table" style="table-layout: fixed;">
                <colgroup>
                    <col style="width: 22%;">
                    <col style="width: 23%;">
                    <col style="width: 14%;">
                    <col style="width: 13%;">
                    <col style="width: 10%;">
                    <col style="width: 10%;">
                    <col style="width: 8%;">
                </colgroup>

                <thead>
                    <tr>
                        <th>Food</th>
                        <th>Quantity</th>
                        <th>Calories</th>
                        <th>Protein</th>
                        <th>Carbs</th>
                        <th>Fat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in mealEntries)
                    {
                        <tr>
                            <td>@entry.Food?.Name</td>
                            <td>
                                @if (entry.FoodPortion != null && entry.PortionQuantity.HasValue)
                                {
                                    <span>
                                        @entry.PortionQuantity.Value.ToString("0.##") × @entry.FoodPortion.Name
                                    </span>

                                    <small class="text-muted d-block">
                                        @entry.Quantity.ToString("0.##") @entry.Food?.ServingUnit
                                    </small>
                                }
                                else
                                {
                                    <span>
                                        @entry.Quantity.ToString("0.##") @entry.Food?.ServingUnit
                                    </span>
                                }
                            </td>
                            <td>@entry.CaloriesConsumed.ToString("0") kcal</td>
                            <td>@entry.ProteinConsumed.ToString("0.0") g</td>
                            <td>@entry.CarbohydratesConsumed.ToString("0.0") g</td>
                            <td>@entry.FatConsumed.ToString("0.0") g</td>
                            <td>
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-page="./Edit"
                                       asp-route-id="@entry.Id"
                                       class="btn btn-sm btn-primary">
                                        Edit
                                    </a>

                                    <a asp-page="./Delete"
                                       asp-route-id="@entry.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}