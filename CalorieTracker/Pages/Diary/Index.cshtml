@page
@model CalorieTracker.Pages.Diary.IndexModel
@{
    ViewData["Title"] = "Daily Diary";
}

<link rel="stylesheet"
      href="~/react-food-search/assets/food-search.css"
      asp-append-version="true" />

<h1>Daily Diary</h1>

<div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
    @if (Model.PreviousDate.HasValue)
    {
        <a asp-page="./Index"
           asp-route-date="@Model.PreviousDate.Value.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">
            ← Previous
        </a>
    }
    else
    {
        <button class="btn btn-outline-secondary" disabled>← Previous</button>
    }

    <strong>
        @Model.SelectedDate.ToString("dddd, d MMMM yyyy")
    </strong>

    <a asp-page="./Index"
       class="btn btn-outline-secondary @(Model.SelectedDate.Date == DateTime.Today ? "disabled" : "")">
        Today
    </a>

    @if (Model.NextDate.HasValue)
    {
        <a asp-page="./Index"
           asp-route-date="@Model.NextDate.Value.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">
            Next →
        </a>
    }
    else
    {
        <button class="btn btn-outline-secondary" disabled>Next →</button>
    }

    <form method="get" class="d-flex align-items-center gap-2 ms-2">
        <input type="date"
               name="date"
               min="1900-01-01"
               max="2100-12-31"
               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
               class="form-control" />

        <button type="submit" class="btn btn-outline-secondary">
            Go
        </button>
    </form>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">Daily Progress</h4>

        @if (Model.DailyCalorieTarget > 0)
        {
            <div class="d-flex justify-content-between align-items-end mb-2">
                <div>
                    <span class="fs-3 fw-bold">
                        @Model.TotalCalories.ToString("0")
                    </span>

                    <span class="text-muted">
                        / @Model.DailyCalorieTarget.ToString("0") kcal
                    </span>
                </div>

                <div class="text-end">
                    @if (Model.CaloriesRemaining >= 0)
                    {
                        <strong>
                            @Model.CaloriesRemaining.ToString("0") kcal remaining
                        </strong>
                    }
                    else
                    {
                        <strong>
                            @Math.Abs(Model.CaloriesRemaining).ToString("0") kcal over
                        </strong>
                    }
                </div>
            </div>

            <div class="progress mb-3" style="height: 20px;">
                <div class="progress-bar"
                     role="progressbar"
                     style="width: @Model.CalorieProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                     aria-valuenow="@Model.CalorieProgressPercent"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @Model.CalorieProgressPercent.ToString("0")%
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">
                Set up your profile and goals to see your daily calorie target.
            </p>
        }

        <div>
            <strong>@Model.TotalProtein.ToString("0.0") g</strong> protein
            <span class="mx-2">·</span>

            <strong>@Model.TotalCarbohydrates.ToString("0.0") g</strong> carbs
            <span class="mx-2">·</span>

            <strong>@Model.TotalFat.ToString("0.0") g</strong> fat
        </div>
    </div>
</div>

@foreach (var meal in new[] { "Breakfast", "Lunch", "Dinner", "Snack" })
{
    var mealEntries = Model.Entries
        .Where(entry => entry.MealType == meal)
        .ToList();

    var mealCalories = mealEntries.Sum(entry => entry.CaloriesConsumed);
    var mealProtein = mealEntries.Sum(entry => entry.ProteinConsumed);
    var mealCarbs = mealEntries.Sum(entry => entry.CarbohydratesConsumed);
    var mealFat = mealEntries.Sum(entry => entry.FatConsumed);

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-2">
            <div>
                <h3 class="mb-0">@meal</h3>

                @if (mealEntries.Count > 0)
                {
                    <small class="text-muted">
                        @mealCalories.ToString("0") kcal ·
                        @mealProtein.ToString("0.0")g protein ·
                        @mealCarbs.ToString("0.0")g carbs ·
                        @mealFat.ToString("0.0")g fat
                    </small>
                }
            </div>

            <a asp-page="./Create"
               asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")"
               asp-route-meal="@meal"
               class="btn btn-sm btn-outline-primary">
                + Add Food
            </a>
        </div>

        @if (mealEntries.Count == 0)
        {
            <div class="food-search-result">
                <span class="text-muted">
                    No foods logged yet.
                </span>
            </div>
        }
        else
        {
            <div class="food-search-list">
                @foreach (var entry in mealEntries)
                {
                    <article class="food-search-result">
                        <div class="food-search-result-main">
                            <div>
                                <h3>@entry.FoodNameSnapshot</h3>

                                @if (entry.PortionQuantity.HasValue &&
                                     !string.IsNullOrWhiteSpace(entry.PortionNameSnapshot))
                                {
                                    <p>
                                        @entry.PortionQuantity.Value.ToString("0.##")
                                        ×
                                        @entry.PortionNameSnapshot
                                    </p>

                                    <small class="text-muted">
                                        @CalorieTracker.Services.MeasurementUnits.FromCanonical(entry.Quantity, entry.ServingUnitSnapshot).ToString("0.##")
                                        @entry.ServingUnitSnapshot
                                    </small>
                                }
                                else
                                {
                                    <p>
                                        @CalorieTracker.Services.MeasurementUnits.FromCanonical(entry.Quantity, entry.ServingUnitSnapshot).ToString("0.##")
                                        @entry.ServingUnitSnapshot
                                    </p>
                                }
                            </div>

                            <strong class="food-search-calories">
                                @entry.CaloriesConsumed.ToString("0") kcal
                            </strong>
                        </div>

                        <div class="food-search-result-bottom">
                            <div class="food-search-macros">
                                <span>
                                    <strong>P</strong>
                                    @entry.ProteinConsumed.ToString("0.0")g
                                </span>

                                <span>
                                    <strong>C</strong>
                                    @entry.CarbohydratesConsumed.ToString("0.0")g
                                </span>

                                <span>
                                    <strong>F</strong>
                                    @entry.FatConsumed.ToString("0.0")g
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <a asp-page="./Edit"
                                   asp-route-id="@entry.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@entry.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}
