@page
@model CalorieTracker.Pages.Diary.DeleteModel
@{
    ViewData["Title"] = "Delete Diary Entry";
}

<h1>Delete Diary Entry</h1>

<h2 class="h3">Are you sure you want to delete this entry?</h2>

<div class="mb-3">
    <strong>Date:</strong> @Model.DiaryEntry.Date.ToShortDateString()
</div>

<div class="mb-3">
    <strong>Meal:</strong> @Model.DiaryEntry.MealType
</div>

<div class="mb-3">
    <strong>Food:</strong> @Model.DiaryEntry.FoodNameSnapshot
</div>

<div class="mb-3">
    <strong>Quantity:</strong>
    @CalorieTracker.Services.MeasurementUnits.FromCanonical(Model.DiaryEntry.Quantity, Model.DiaryEntry.ServingUnitSnapshot).ToString("0.##") @Model.DiaryEntry.ServingUnitSnapshot
</div>

<form method="post">
    <input type="hidden" name="id" value="@Model.DiaryEntry.Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" asp-route-date="@Model.DiaryEntry.Date.ToString("yyyy-MM-dd")" class="btn btn-secondary">Cancel</a>
</form>
