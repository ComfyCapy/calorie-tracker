@page
@model CalorieTracker.Pages.Diary.CreateModel

<h1>Add Diary Entry</h1>

<form method="post">

    <div class="form-group">
        <label asp-for="DiaryEntry.Date" class="control-label"></label>
        <input asp-for="DiaryEntry.Date" type="date" class="form-control" />
        <span asp-validation-for="DiaryEntry.Date" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DiaryEntry.MealType" class="control-label">Meal</label>
        <select asp-for="DiaryEntry.MealType" class="form-control">
            <option value="Breakfast">Breakfast</option>
            <option value="Lunch">Lunch</option>
            <option value="Dinner">Dinner</option>
            <option value="Snack">Snack</option>
        </select>
        <span asp-validation-for="DiaryEntry.MealType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DiaryEntry.FoodId" class="control-label">Food</label>
        <select asp-for="DiaryEntry.FoodId"
                id="foodSelect"
                class="form-control">
            @foreach (var food in Model.FoodOptions)
            {
                <option value="@food.Id"
                        data-unit="@food.ServingUnit">
                    @food.Name
                </option>
            }
        </select>
        <span asp-validation-for="DiaryEntry.FoodId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DiaryEntry.Quantity">
            Quantity (<span id="quantityUnit"></span>)
        </label>
        <input asp-for="DiaryEntry.Quantity" class="form-control" />
        <span asp-validation-for="DiaryEntry.Quantity" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Add to Diary</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </div>

</form>
@section Scripts {
    <script>
        const foodSelect = document.getElementById("foodSelect");
        const quantityUnit = document.getElementById("quantityUnit");

        function updateQuantityUnit() {
            const selectedOption = foodSelect.options[foodSelect.selectedIndex];
            quantityUnit.textContent = selectedOption.dataset.unit;
        }

        foodSelect.addEventListener("change", updateQuantityUnit);

        updateQuantityUnit();
    </script>
}