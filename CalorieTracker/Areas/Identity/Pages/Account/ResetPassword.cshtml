@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<h1>@ViewData["Title"]</h1>
<p class="text-body-secondary">Use a strong password you do not use elsewhere.</p>
<div class="row">
    <div class="col-12 account-form-shell">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="mb-3">
                <div class="form-floating">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder=" " />
                    <label asp-for="Input.Email"
                           class="form-label">
                    </label>
                </div>

                <span asp-validation-for="Input.Email"
                      class="text-danger d-block mt-1">
                </span>
            </div>
            <div class="mb-3">
                <div class="form-floating">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder=" " />
                    <label asp-for="Input.Password"
                           class="form-label">
                    </label>
                </div>

                <span asp-validation-for="Input.Password"
                      class="text-danger d-block mt-1">
                </span>
            </div>
            <div class="mb-3">
                <div class="form-floating">
                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder=" " />
                    <label asp-for="Input.ConfirmPassword"
                           class="form-label">
                    </label>
                </div>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger d-block mt-1">
                </span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Save new password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
