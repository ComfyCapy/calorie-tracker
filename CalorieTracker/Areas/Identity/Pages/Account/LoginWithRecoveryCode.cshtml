@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Use a recovery code";
}

<h1>@ViewData["Title"]</h1>
<p>
    Enter one of the recovery codes you saved when setting up two-factor authentication. This login will not
    be remembered until you later use an authenticator code or disable 2FA and log in again.
</p>
<div class="row">
    <div class="col-12 account-form-shell">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="RecoveryCode" />
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
