@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Need a new confirmation email?";
}

<h1>@ViewData["Title"]</h1>
<p class="text-body-secondary">Enter your email and we'll send a fresh confirmation link.</p>
<div class="row">
    <div class="col-12 account-form-shell">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder=" " />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Send confirmation email</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
