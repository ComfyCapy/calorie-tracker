@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your inbox";
}

<h1>@ViewData["Title"]</h1>
<p>
    If an account matches the address you entered, a password-reset link is on its way.
</p>
<p class="text-body-secondary">It may take a few minutes to arrive. Remember to check your spam folder.</p>
