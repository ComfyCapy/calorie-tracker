@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "One last tiny step";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    Email delivery is not configured in this environment. Use this development-only
    <a id="confirm-link" href="@Model.EmailConfirmationUrl">account confirmation link</a>.
</p>
    }
    else
    {
<p>
        Check your inbox for a confirmation link, then your Comfy Capy Calories account will be ready to use.
</p>
    }
}

