@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Your data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="h3">@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-6">
        <p>Download the personal account data exposed by ASP.NET Core Identity, or permanently delete your account.</p>
        <p>For a readable overview of other information used by the app, see our <a asp-page="/Privacy" asp-area="">Privacy page</a>.</p>
        <p>
            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Download account data</button>
        </form>
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Delete my account</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
