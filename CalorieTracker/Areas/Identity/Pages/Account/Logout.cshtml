@page
@model LogoutModel
@{
    ViewData["Title"] = "Ready to head out?";
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <p>Log out of Comfy Capy Calories on this device.</p>
                <button type="submit" class="btn btn-primary">Log out</button>
            </form>
        }
        else
        {
            <p>You're safely signed out. Your Diary and Capy will be here when you return.</p>
            <a asp-page="./Login" class="btn btn-primary">Log in again</a>
        }
    }
</header>
